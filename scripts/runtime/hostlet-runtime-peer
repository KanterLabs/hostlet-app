STATE_MARKER = "hostlet-runtime-state-v1"
REGISTRY_NAME = "runtime-peer-registry"
TARGET_SCHEMA = "hostlet.runtime.peer-target/v1"
PEER_SCHEMA = "hostlet.runtime.postgres-peer/v2"
