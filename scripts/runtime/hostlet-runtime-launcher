owned_absent_or_dir() { [[ ! -e "$1" || -d "$1" ]] || { echo runtime_owned_path_invalid >&2; exit 1; }; }

mount_identity() {
  local target=$1
  findmnt -n -o ID,SOURCE,FSROOT,TARGET,FSTYPE,OPTIONS --mountpoint "$target" 2>/dev/null
}

ensure_mount_root() {
  local created=false
  if [[ ! -e "$mount_root" ]]; then
    mkdir -m 0711 "$mount_root"
    chown root:root "$mount_root"
    created=true
  fi
  [[ -d "$mount_root" && ! -L "$mount_root" && "$(stat -c %u:%g:%a "$mount_root")" == 0:0:711 ]] || { echo runtime_mount_root_not_owned >&2; return 1; }
  if [[ "$created" == true ]]; then
    printf 'hostlet-runtime-mount-root-v1\n' > "$mount_root_marker"
    chown root:root "$mount_root_marker"
    chmod 0600 "$mount_root_marker"
  fi
  [[ -f "$mount_root_marker" && ! -L "$mount_root_marker" && "$(cat "$mount_root_marker")" == hostlet-runtime-mount-root-v1 ]] || { echo runtime_mount_root_not_owned >&2; return 1; }
  [[ "$(stat -c %u:%g:%a "$mount_root_marker")" == 0:0:600 ]] || { echo runtime_mount_root_not_owned >&2; return 1; }
}

create_mount_tuple() {
  ensure_mount_root || return 1
