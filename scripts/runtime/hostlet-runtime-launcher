mount_runtime_secrets() {
  mkdir "$secret_mount"
  chown root:100000 "$secret_mount"
  chmod 0710 "$secret_mount"
  mount -t tmpfs -o nodev,nosuid,noexec,mode=0710,size=1m tmpfs "$secret_mount"
  secret_target_inode=$(stat -Lc %i "$secret_mount")
  secret_mount_identity=$(mount_identity "$secret_mount")
  chown 165532:100000 "$secret_mount"
  chmod 0550 "$secret_mount"
  secret_mount_identity=$(mount_identity "$secret_mount")
