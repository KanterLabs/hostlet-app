  mkdir "$mount_tuple"
  chown root:100000 "$mount_tuple"
  chmod 0710 "$mount_tuple"
  printf 'hostlet-runtime-mount-v1 allocation=%s generation=%s fence=%s\n' "$id" "$generation" "$fence" > "$mount_tuple_marker"
  chown root:root "$mount_tuple_marker"
  chmod 0600 "$mount_tuple_marker"
  mkdir "$rootfs_mount"
  chown root:100000 "$rootfs_mount"
  chmod 0710 "$rootfs_mount"
}

validate_mount_tuple() {
  [[ -d "$mount_tuple" && ! -L "$mount_tuple" && "$(stat -c %u:%g:%a "$mount_tuple")" == 0:100000:710 ]] || return 1
  [[ -f "$mount_tuple_marker" && ! -L "$mount_tuple_marker" && "$(cat "$mount_tuple_marker")" == "hostlet-runtime-mount-v1 allocation=$id generation=$generation fence=$fence" ]] || return 1
  [[ "$(stat -c %u:%g:%a "$mount_tuple_marker")" == 0:0:600 ]] || return 1
