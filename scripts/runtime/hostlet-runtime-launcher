#!/usr/bin/env bash
set -euo pipefail
umask 077

# Use an explicit integer conversion; date implementations differ on %3N.
now_ms() { python3 -c 'import time; print(time.time_ns() // 1_000_000)'; }

request= request_sha256= state_root= artifact_root= runsc=
while (($#)); do
  case "$1" in
    --request-file) request=$2; shift 2;; --request-sha256) request_sha256=$2; shift 2;; --state-root) state_root=$2; shift 2;;
    --artifact-root) artifact_root=$2; shift 2;; --runsc) runsc=$2; shift 2;;
    *) echo runtime_launcher_usage >&2; exit 2;;
  esac
done
for value in "$request" "$state_root" "$artifact_root" "$runsc"; do [[ "$value" == /* ]] || { echo runtime_path_not_absolute >&2; exit 2; }; done
[[ -f "$request" && -x "$runsc" ]] || { echo runtime_prerequisite_missing >&2; exit 2; }
[[ "$request_sha256" =~ ^[0-9a-f]{64}$ ]] || { echo runtime_request_digest_mismatch >&2; exit 2; }
[[ ! -L "$request" && "$(stat -c %F "$request")" == "regular file" && "$(stat -c %a "$request")" =~ ^(400|440|600|640)$ ]] || { echo runtime_request_permissions_invalid >&2; exit 2; }
[[ -d "$state_root" && ! -L "$state_root" && -f "$state_root/.hostlet-runtime-owned" ]] || { echo runtime_state_root_not_owned >&2; exit 2; }
[[ -d "$artifact_root" && ! -L "$artifact_root" && -f "$artifact_root/.hostlet-artifacts-owned" ]] || { echo runtime_artifact_root_not_owned >&2; exit 2; }
[[ "$(cat "$state_root/.hostlet-runtime-owned")" == hostlet-runtime-state-v1 ]] || { echo runtime_state_root_not_owned >&2; exit 2; }
[[ "$(cat "$artifact_root/.hostlet-artifacts-owned")" == hostlet-artifacts-v1 ]] || { echo runtime_artifact_root_not_owned >&2; exit 2; }
request_copy=$(mktemp "${state_root}/.request.XXXXXX")
trap 'rm -f -- "$request_copy"' EXIT
cp --reflink=never -- "$request" "$request_copy"
chmod 0400 "$request_copy"
[[ "$(sha256sum "$request_copy" | awk '{print $1}')" == "$request_sha256" ]] || { echo runtime_request_digest_mismatch >&2; exit 2; }
request=$request_copy
jq -e '.schema=="hostlet.runtime.executor-request/v1" and (.profile=="owned_fixture_evaluation" or .profile=="evidence_gated_owned_fixture")' "$request" >/dev/null
op=$(jq -r .operation "$request"); id=$(jq -r .allocation_id "$request"); generation=$(jq -r .generation "$request"); fence=$(jq -r .fence "$request")
[[ "$id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ && "$generation" =~ ^[1-9][0-9]*$ && "$fence" =~ ^[1-9][0-9]*$ ]] || { echo runtime_identity_invalid >&2; exit 2; }
jq -e '(.profile=="owned_fixture_evaluation" and .capability_digest==null) or (.profile=="evidence_gated_owned_fixture" and (.capability_digest|test("^sha256:[0-9a-f]{64}$")))' "$request" >/dev/null || { echo runtime_isolation_unverified >&2; exit 2; }
jq -e '.resources=={memory_bytes:536870912,memory_swap_bytes:0,cpu_quota_micros:25000,cpu_period_micros:100000,pids:128,scratch_bytes:268435456,max_connections:128,new_connections_per_second:20,new_connections_burst:40}' "$request" >/dev/null || { echo runtime_policy_not_admitted >&2; exit 2; }
identity_hash=$(printf '%s:%s' "$id" "$generation" | sha256sum | cut -c1-10); sandbox="h${identity_hash}g${generation}"; app_ns="hostlet-app-${id}-${generation}"; gateway_ns="hostlet-gateway-${id}-${generation}"; short=$identity_hash; sink_iface="s${short}"
cgroup_identity_hash=$(printf '%s:%s:%s' "$id" "$generation" "$fence" | sha256sum | cut -c1-16)
cgroup_parent=/sys/fs/cgroup
cgroup_state_file=
cgroup_tombstone_dir="${state_root}/runtime-cgroup-tombstones"
cgroup_tombstone_file="${cgroup_tombstone_dir}/${id}-${generation}-${fence}.json"
cgroup_epoch=1
cgroup_relative=
cgroup_root=
cgroup_inode=
request_identity_sha256=$(jq -cS 'del(.operation,.observed_at_unix_ms,.exit_history_unix_ms)' "$request" | sha256sum | awk '{print $1}')
generation_root="${state_root}/${id}/${generation}"; bundle="${generation_root}/bundle"; run_root="${state_root}/runsc"; evidence="${generation_root}/evidence"; cgroup_state_file="${evidence}/cgroup-state.json"
digest=$(jq -r .artifact_digest "$request"); hex=${digest#sha256:}
manifest_digest=$(jq -r .artifact_manifest_digest "$request"); manifest_hex=${manifest_digest#sha256:}
profile_digest=$(jq -r .build_profile_digest "$request"); profile_hex=${profile_digest#sha256:}
[[ "$digest" == "sha256:${hex}" && "$hex" =~ ^[0-9a-f]{64}$ && "$manifest_digest" == "sha256:${manifest_hex}" && "$manifest_hex" =~ ^[0-9a-f]{64}$ && "$profile_digest" == "sha256:${profile_hex}" && "$profile_hex" =~ ^[0-9a-f]{64}$ ]] || { echo runtime_digest_invalid >&2; exit 2; }
rootfs="${artifact_root}/${manifest_hex}/rootfs"
[[ "$rootfs" == "${artifact_root}/"* ]] || { echo runtime_artifact_escape >&2; exit 2; }
mount_root=/run/hostlet-owned-fixture-mounts
mount_root_marker="${mount_root}/.hostlet-owned"
mount_tuple="${mount_root}/${id}-${generation}-${fence}"
mount_tuple_marker="${mount_tuple}/.hostlet-owned"
rootfs_mount="${mount_tuple}/rootfs"
secret_mount="${mount_tuple}/secrets"
rootfs_source_inode= rootfs_target_inode= rootfs_mount_identity=
secret_target_inode= secret_mount_identity=
prepare_cleanup_armed=false
# The launcher owns a pre-created direct child of the cgroup-v2 root. Keeping
# the filesystem driver avoids a transient systemd scope deleting the final
# counters when the sandbox exits. The OCI resource fields remain the policy
# reference; runsc leaves an already-existing cgroup configured by its caller.
global=(--root="$run_root" --platform="$(jq -r .platform "$request")" --network=sandbox --sidecar-usage-policy=STRICT --sidecar-release-enforcement-policy=ALWAYS)
# M3 has no tenant log delivery contract. Keep OCI stdio off the trusted receipt
# channel; bounded tenant log capture and delivery are deferred to M4.
runsc_quiet() { "$runsc" "${global[@]}" "$@" </dev/null >/dev/null 2>&1; }
expected_runsc=$(jq -r '.runtime_binary_digest|sub("^sha256:";"")' "$request"); observed_runsc=$(sha256sum "$runsc" | awk '{print $1}')
[[ "$expected_runsc" == c0f4ec0ac1198975d5cf919a78f2302426de096f69eebd33e50125c3ca42d699 && "$expected_runsc" == "$observed_runsc" ]] || { echo runtime_binary_digest_mismatch >&2; exit 1; }
runsc_dir=$(dirname "$runsc")
while IFS=$'\t' read -r expected relative; do
  sidecar="$runsc_dir/$relative"
  [[ -f "$sidecar" && ! -L "$sidecar" && "$(sha256sum "$sidecar" | awk '{print $1}')" == "$expected" ]] || { echo runtime_sidecar_digest_mismatch >&2; exit 1; }
done <<'EOF'
4b0c2a8eb7414d8b5f3d032e158784b454e9c98ffa3fdebbdd79047faf930d7c	containerd-shim-runsc-v1
e29be2ab32a10eb885c4a46635f47b80ad661be6f23b5d7903f11906941c7aab	gvisor-bin/checkpointgofer
3315d7ad7c2d3751d349e4976fa02da1da6fd7e41746c35622304e5fabe4fce0	gvisor-bin/gvisor-sentry-prewarmer
aff3ed7dfac54b04aab14de2dde53e021402f0ba238bc7ece3ac7d4b6604b055	gvisor-bin/gvisor_sentry
03af90d07ea466c10ecc3e3ba839b2a59540959dd3286aea3886917cba850c11	gvisor-bin/runsc-fd-parking
02bb563cd060fe7992ccd00927024b02b70e0803b61abfa015e158d9d7e88507	gvisor-bin/runsc-metric-server
EOF

cgroup_path_for_epoch() {
  local epoch=$1
  printf '/hostlet-owned-runtime-%s-e%s' "$cgroup_identity_hash" "$epoch"
}

validate_cgroup_parent() {
  local available enabled controller
  [[ -d "$cgroup_parent" && ! -L "$cgroup_parent" ]] || return 1
  [[ "$(realpath -e -- "$cgroup_parent")" == "$cgroup_parent" ]] || return 1
  [[ "$(stat -fc %T -- "$cgroup_parent")" == cgroup2fs ]] || return 1
  [[ -f "$cgroup_parent/cgroup.controllers" && -f "$cgroup_parent/cgroup.subtree_control" ]] || return 1
  available=$(cat -- "$cgroup_parent/cgroup.controllers") || return 1
  enabled=$(cat -- "$cgroup_parent/cgroup.subtree_control") || return 1
  [[ -n "$available" ]] || return 1
  for controller in $available; do
    [[ " $enabled " == *" $controller "* ]] || return 1
  done
}

validate_cgroup_identity() {
  local relative=$1 epoch=$2 inode=${3:-} root expected_epoch
  [[ "$relative" =~ ^/hostlet-owned-runtime-${cgroup_identity_hash}-e([1-9][0-9]*)$ ]] || return 1
  expected_epoch=${BASH_REMATCH[1]}
  [[ "$expected_epoch" == "$epoch" ]] || return 1
  root="${cgroup_parent}${relative}"
  [[ ! -L "$root" ]] || return 1
  if [[ -e "$root" ]]; then
    [[ -d "$root" && "$(realpath -e -- "$root")" == "$root" ]] || return 1
    if [[ -n "$inode" ]]; then
      [[ "$inode" =~ ^[1-9][0-9]*$ && "$(stat -Lc %i -- "$root")" == "$inode" ]] || return 1
    fi
  fi
  return 0
}

write_cgroup_state() {
  local epoch=$1 relative=$2 inode=${3:-} temporary
  [[ "$epoch" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -d "$evidence" && ! -L "$evidence" ]] || return 1
  validate_cgroup_identity "$relative" "$epoch" "$inode" || return 1
  temporary="${cgroup_state_file}.new"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
  if [[ -n "$inode" ]]; then
    jq -cn --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" \
      --arg identity "$cgroup_identity_hash" --arg path "$relative" --argjson epoch "$epoch" --argjson inode "$inode" \
      '{schema:"hostlet.runtime.cgroup-state/v1",allocation_id:$id,generation:$generation,fence:$fence,identity_hash:$identity,cgroup_path:$path,cgroup_epoch:$epoch,cgroup_inode:$inode}' > "$temporary"
  else
    jq -cn --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" \
      --arg identity "$cgroup_identity_hash" --arg path "$relative" --argjson epoch "$epoch" \
      '{schema:"hostlet.runtime.cgroup-state/v1",allocation_id:$id,generation:$generation,fence:$fence,identity_hash:$identity,cgroup_path:$path,cgroup_epoch:$epoch,cgroup_inode:null}' > "$temporary"
  fi
  chmod 0600 -- "$temporary"
  mv -- "$temporary" "$cgroup_state_file"
}

load_cgroup_state() {
  [[ -f "$cgroup_state_file" && ! -L "$cgroup_state_file" ]] || return 1
  jq -e --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" \
    --arg identity "$cgroup_identity_hash" \
    '.schema=="hostlet.runtime.cgroup-state/v1" and .allocation_id==$id and .generation==$generation and .fence==$fence and .identity_hash==$identity and (.cgroup_epoch|type=="number" and floor==. and . >= 1) and (.cgroup_path|type=="string") and ((.cgroup_inode==null) or (.cgroup_inode|type=="number" and floor==. and . >= 1))' \
    "$cgroup_state_file" >/dev/null || return 1
  cgroup_epoch=$(jq -r '.cgroup_epoch' "$cgroup_state_file")
  cgroup_relative=$(jq -r '.cgroup_path' "$cgroup_state_file")
  cgroup_inode=$(jq -r '.cgroup_inode // empty' "$cgroup_state_file")
  validate_cgroup_identity "$cgroup_relative" "$cgroup_epoch" "$cgroup_inode" || return 1
  cgroup_root="${cgroup_parent}${cgroup_relative}"
}

record_cgroup_ownership() {
  local ownership="$generation_root/OWNERSHIP.json" temporary
  [[ -f "$ownership" && ! -L "$ownership" ]] || return 1
  temporary="${ownership}.new"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
  jq --arg path "$cgroup_relative" --argjson epoch "$cgroup_epoch" --argjson inode "${cgroup_inode:-null}" \
    --arg identity "$cgroup_identity_hash" '. + {cgroup_identity_hash:$identity,cgroup_path:$path,cgroup_epoch:$epoch,cgroup_inode:$inode}' "$ownership" > "$temporary"
  chmod 0600 -- "$temporary"
  mv -- "$temporary" "$ownership"
}

create_budget_cgroup() {
  local existing_inode controls_ok=false
  validate_cgroup_parent || { echo runtime_cgroup_parent_invalid >&2; return 1; }
  load_cgroup_state || { echo runtime_cgroup_state_invalid >&2; return 1; }
  if [[ -e "$cgroup_root" || -L "$cgroup_root" ]]; then
    [[ -d "$cgroup_root" && ! -L "$cgroup_root" && "$(realpath -e -- "$cgroup_root")" == "$cgroup_root" ]] || { echo runtime_cgroup_path_changed >&2; return 1; }
    existing_inode=$(stat -Lc %i -- "$cgroup_root")
    [[ -n "$cgroup_inode" && "$existing_inode" == "$cgroup_inode" ]] || { echo runtime_cgroup_collision >&2; return 1; }
    # A same-epoch leaf is durable evidence for this attempt. Reusing it would
    # erase memory/PID/CPU counters and could hide an interrupted worker.
    echo runtime_cgroup_exists >&2
    return 1
  fi
  mkdir -- "$cgroup_root" || { echo runtime_cgroup_create_failed >&2; return 1; }
  cgroup_inode=$(stat -Lc %i -- "$cgroup_root")
  [[ "$cgroup_inode" =~ ^[1-9][0-9]*$ ]] || { echo runtime_cgroup_inode_invalid >&2; return 1; }
  write_cgroup_state "$cgroup_epoch" "$cgroup_relative" "$cgroup_inode" || return 1
  record_cgroup_ownership || { echo runtime_cgroup_ownership_failed >&2; return 1; }
  if
    printf '25000 100000\n' > "$cgroup_root/cpu.max" &&
    printf '536870912\n' > "$cgroup_root/memory.max" &&
    printf '0\n' > "$cgroup_root/memory.swap.max" &&
    printf '128\n' > "$cgroup_root/pids.max" &&
    printf '1\n' > "$cgroup_root/memory.oom.group" &&
    [[ "$(cat -- "$cgroup_root/cpu.max")" == '25000 100000' ]] &&
    [[ "$(cat -- "$cgroup_root/memory.max")" == 536870912 ]] &&
    [[ "$(cat -- "$cgroup_root/memory.swap.max")" == 0 ]] &&
    [[ "$(cat -- "$cgroup_root/pids.max")" == 128 ]] &&
    [[ "$(cat -- "$cgroup_root/memory.oom.group")" == 1 ]]
  then
    controls_ok=true
  fi
  if [[ "$controls_ok" != true ]]; then
    # The path and inode are already journaled. Remove only that exact empty
    # leaf; if a writer appeared, retain it for ownership-checked cleanup.
    remove_budget_cgroup || true
    echo runtime_cgroup_limits_invalid >&2
    return 1
  fi
  return 0
}

remove_budget_cgroup() {
  validate_cgroup_parent || { echo runtime_cgroup_parent_invalid >&2; return 1; }
  load_cgroup_state || { echo runtime_cgroup_state_invalid >&2; return 1; }
  [[ ! -e "$cgroup_root" && ! -L "$cgroup_root" ]] && return 0
  [[ -d "$cgroup_root" && ! -L "$cgroup_root" && "$(realpath -e -- "$cgroup_root")" == "$cgroup_root" ]] || { echo runtime_cgroup_path_changed >&2; return 1; }
  [[ -n "$cgroup_inode" ]] || { echo runtime_cgroup_inode_missing >&2; return 1; }
  [[ "$(stat -Lc %i -- "$cgroup_root")" == "$cgroup_inode" ]] || { echo runtime_cgroup_inode_changed >&2; return 1; }
  [[ -z "$(cat -- "$cgroup_root/cgroup.procs")" ]] || { echo runtime_cgroup_not_empty >&2; return 1; }
  [[ "$(awk '$1=="populated"{print $2}' "$cgroup_root/cgroup.events")" == 0 ]] || { echo runtime_cgroup_descendants_present >&2; return 1; }
  rmdir -- "$cgroup_root" || { echo runtime_cgroup_remove_failed >&2; return 1; }
}

advance_budget_epoch() {
  load_cgroup_state || return 1
  remove_budget_cgroup || return 1
  cgroup_epoch=$((cgroup_epoch + 1))
  cgroup_relative=$(cgroup_path_for_epoch "$cgroup_epoch")
  cgroup_inode=
  write_cgroup_state "$cgroup_epoch" "$cgroup_relative" "" || return 1
  record_cgroup_ownership
}

validate_cgroup_config_path() {
  [[ -f "$bundle/config.json" && ! -L "$bundle/config.json" ]] || return 1
  jq -e --arg path "$cgroup_relative" '.linux.cgroupsPath==$path' "$bundle/config.json" >/dev/null
}

update_cgroup_config_path() {
  local temporary="${bundle}/config.json.new"
  validate_cgroup_identity "$cgroup_relative" "$cgroup_epoch" "" || return 1
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
  jq --arg path "$cgroup_relative" '.linux.cgroupsPath=$path' "$bundle/config.json" > "$temporary"
  chmod 0600 -- "$temporary"
  mv -- "$temporary" "$bundle/config.json"
  validate_cgroup_config_path || return 1
  sha256sum "$bundle/config.json" "$evidence/gateway-ruleset.txt" > "$evidence/SHA256SUMS"
}

write_cgroup_tombstone() {
  local temporary
  load_cgroup_state || return 1
  [[ ! -e "$cgroup_root" && ! -L "$cgroup_root" ]] || { echo runtime_cgroup_not_removed >&2; return 1; }
  if [[ ! -e "$cgroup_tombstone_dir" ]]; then
    mkdir -m 0700 -- "$cgroup_tombstone_dir" || return 1
    chown 0:0 -- "$cgroup_tombstone_dir" || return 1
  fi
  [[ -d "$cgroup_tombstone_dir" && ! -L "$cgroup_tombstone_dir" && "$(realpath -e -- "$cgroup_tombstone_dir")" == "$cgroup_tombstone_dir" ]] || return 1
  [[ "$(stat -c '%u:%a' -- "$cgroup_tombstone_dir")" == 0:700 ]] || return 1
  temporary="${cgroup_tombstone_file}.new"
  [[ ! -e "$temporary" && ! -L "$temporary" ]] || return 1
  jq -cn --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" \
    --arg identity "$cgroup_identity_hash" --arg path "$cgroup_relative" --argjson epoch "$cgroup_epoch" --argjson inode "${cgroup_inode:-null}" \
    '{schema:"hostlet.runtime.cgroup-tombstone/v1",allocation_id:$id,generation:$generation,fence:$fence,identity_hash:$identity,cgroup_path:$path,cgroup_epoch:$epoch,cgroup_inode:$inode}' > "$temporary"
  chmod 0600 -- "$temporary"
  chown 0:0 -- "$temporary"
  mv -- "$temporary" "$cgroup_tombstone_file"
}

load_cgroup_tombstone() {
  local path epoch inode
  [[ -f "$cgroup_tombstone_file" && ! -L "$cgroup_tombstone_file" ]] || return 1
  [[ -d "$cgroup_tombstone_dir" && ! -L "$cgroup_tombstone_dir" && "$(realpath -e -- "$cgroup_tombstone_dir")" == "$cgroup_tombstone_dir" ]] || return 1
  [[ "$(stat -c '%u:%a' -- "$cgroup_tombstone_dir")" == 0:700 ]] || return 1
  [[ "$(stat -c '%u:%a' -- "$cgroup_tombstone_file")" == 0:600 && "$(realpath -e -- "$cgroup_tombstone_file")" == "$cgroup_tombstone_file" ]] || return 1
  jq -e --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" \
    --arg identity "$cgroup_identity_hash" \
    '.schema=="hostlet.runtime.cgroup-tombstone/v1" and .allocation_id==$id and .generation==$generation and .fence==$fence and .identity_hash==$identity and (.cgroup_epoch|type=="number" and floor==. and . >= 1) and (.cgroup_path|type=="string") and ((.cgroup_inode==null) or (.cgroup_inode|type=="number" and floor==. and . >= 1))' \
    "$cgroup_tombstone_file" >/dev/null || return 1
  path=$(jq -r '.cgroup_path' "$cgroup_tombstone_file")
  epoch=$(jq -r '.cgroup_epoch' "$cgroup_tombstone_file")
  inode=$(jq -r '.cgroup_inode // empty' "$cgroup_tombstone_file")
  validate_cgroup_identity "$path" "$epoch" "$inode" || return 1
  cgroup_relative=$path
  cgroup_epoch=$epoch
  cgroup_inode=$inode
  cgroup_root="${cgroup_parent}${cgroup_relative}"
}

remove_tombstoned_cgroup() {
  validate_cgroup_parent || { echo runtime_cgroup_parent_invalid >&2; return 1; }
  load_cgroup_tombstone || { echo runtime_cgroup_tombstone_invalid >&2; return 1; }
  [[ ! -e "$cgroup_root" && ! -L "$cgroup_root" ]] && return 0
  [[ -d "$cgroup_root" && ! -L "$cgroup_root" && "$(realpath -e -- "$cgroup_root")" == "$cgroup_root" ]] || { echo runtime_cgroup_path_changed >&2; return 1; }
  [[ "$(stat -Lc %i -- "$cgroup_root")" == "$cgroup_inode" ]] || { echo runtime_cgroup_inode_changed >&2; return 1; }
  [[ -z "$(cat -- "$cgroup_root/cgroup.procs")" ]] || { echo runtime_cgroup_not_empty >&2; return 1; }
  [[ "$(awk '$1=="populated"{print $2}' "$cgroup_root/cgroup.events")" == 0 ]] || { echo runtime_cgroup_descendants_present >&2; return 1; }
  rmdir -- "$cgroup_root" || { echo runtime_cgroup_remove_failed >&2; return 1; }
}

observe_scratch() {
  local raw block_size total_blocks available_blocks extra capacity_bytes available_bytes
  raw=$(/usr/bin/timeout --signal=KILL --kill-after=1s 2s "$runsc" "${global[@]}" exec "$sandbox" /usr/bin/stat -f --format='%S:%b:%a' /tmp </dev/null 2>/dev/null) || return 1
  IFS=: read -r block_size total_blocks available_blocks extra <<< "$raw"
  [[ -z "$extra" && "$block_size" =~ ^[1-9][0-9]*$ && "$total_blocks" =~ ^[1-9][0-9]*$ && "$available_blocks" =~ ^[0-9]+$ ]] || return 1
  (( block_size <= 1048576 && total_blocks <= 1048576 && available_blocks <= total_blocks )) || return 1
  capacity_bytes=$((block_size * total_blocks)); available_bytes=$((block_size * available_blocks))
  [[ "$capacity_bytes" == 268435456 && "$available_bytes" -le "$capacity_bytes" ]] || return 1
  jq -cn --argjson capacity "$capacity_bytes" --argjson available "$available_bytes" \
    '{capacity_bytes:$capacity,available_bytes:$available}'
}

emit() {
  local status=$1 reason=$2 health=${3:-false} result=${4:-passed} observed_at config_digest= rules_digest= app_inode= gateway_inode= runsc_status= observed=null scratch_observation=null health_json cleanup_json network_json cgroup_absent=false
  observed_at=$(now_ms)
  [[ -f "$bundle/config.json" ]] && config_digest="sha256:$(sha256sum "$bundle/config.json" | awk '{print $1}')"
  [[ -f "$evidence/gateway-ruleset.txt" ]] && rules_digest="sha256:$(sha256sum "$evidence/gateway-ruleset.txt" | awk '{print $1}')"
  [[ -e "/run/netns/$app_ns" ]] && app_inode=$(stat -Lc %i "/run/netns/$app_ns")
  [[ -e "/run/netns/$gateway_ns" ]] && gateway_inode=$(stat -Lc %i "/run/netns/$gateway_ns")
  if "$runsc" "${global[@]}" state "$sandbox" > "$evidence/runsc-state.json" 2>/dev/null; then runsc_status=$(jq -r .status "$evidence/runsc-state.json"); observed=$(observe_cgroup "$evidence/runsc-state.json"); fi
  [[ "$observed" != null ]] || observed=$(observe_cgroup "")
  if [[ "$observed" != null ]]; then
    [[ "$(jq -r '.pids_events.max > 0' <<<"$observed")" == true ]] && reason=process_limit_exceeded
    [[ "$(jq -r '.memory_events.oom_kill > 0' <<<"$observed")" == true ]] && reason=runtime_oom
    [[ "$(jq -r '.cpu_nr_throttled > 0' <<<"$observed")" == true && "$reason" == runtime_started ]] && reason=cpu_throttled
  fi
  health_json=$(health_observation "$health")
  counters='[]'; if [[ -e "/run/netns/$gateway_ns" ]]; then counters=$(ip netns exec "$gateway_ns" nft -j list counters 2>/dev/null | jq '[.nftables[]|select(.counter)|.counter|{name,packets,bytes}]' || echo '[]'); fi
  if [[ ( "$reason" == runtime_started || "$reason" == cpu_throttled ) && "$(jq '[.[]|select(.name=="connection_limited")|.packets]|add//0' <<<"$counters")" -gt 0 ]]; then reason=network_connection_limit; fi
  if [[ "$runsc_status" == running ]]; then
    scratch_observation=$(observe_scratch || true)
