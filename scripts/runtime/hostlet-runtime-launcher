    secret_target_inode=$(jq -r '.mounts.secret.target_inode // empty' "$ownership")
    secret_mount_identity=$(jq -r '.mounts.secret.identity // empty' "$ownership")
    [[ "$(jq -r '.mounts.secret.source // empty' "$ownership")" == tmpfs && "$(jq -r '.mounts.secret.target // empty' "$ownership")" == "$secret_mount" && "$secret_target_inode" =~ ^[1-9][0-9]*$ ]] || { echo runtime_secret_mount_invalid >&2; return 1; }
