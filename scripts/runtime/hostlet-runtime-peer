def route_matches(entries: list[dict[str, Any]], target: str, gateway: str, interface: str, family: int) -> bool:
    prefix = 32 if family == 4 else 128
    try:
        expected = ipaddress.ip_network(f"{target}/{prefix}", strict=False)
    except ValueError:
        return False
    for item in entries:
        destination = item.get("dst")
        if not isinstance(destination, str):
            continue
        try:
            observed = ipaddress.ip_network(destination if "/" in destination else f"{destination}/{prefix}", strict=False)
        except ValueError:
            continue
        if observed == expected and item.get("gateway") == gateway and item.get("dev") == interface:
            return True
    return False


def validate_member_shape(member: Any) -> None:
    require(isinstance(member, dict), "peer_registry_member_invalid")
    require(set(member) == MEMBER_FIELDS, "peer_registry_member_invalid")
    validate_uuid(member.get("allocation_id"), "peer_registry_member_invalid")
    for field in POSITIVE_FIELDS:
        validate_positive(member.get(field), "peer_registry_member_invalid")
    require(isinstance(member.get("runtime_generation"), int) and not isinstance(member["runtime_generation"], bool) and member["runtime_generation"] > 0 and isinstance(member.get("runtime_fence"), int) and not isinstance(member["runtime_fence"], bool) and member["runtime_fence"] > 0, "peer_registry_member_invalid")
    require(isinstance(member.get("container_id"), str) and CONTAINER_RE.fullmatch(member["container_id"]) is not None, "peer_registry_member_invalid")
    for field in ("interface", "gateway_interface"):
        require(isinstance(member.get(field), str) and IFACE_RE.fullmatch(member[field]) is not None, "peer_registry_member_invalid")
    for field in ("interface_mac", "gateway_interface_mac"):
        require(isinstance(member.get(field), str) and MAC_RE.fullmatch(member[field]) is not None, "peer_registry_member_invalid")
    for field in ("transport_ipv4", "transport_gateway_ipv4", "application_ipv4"):
        try:
            require(ipaddress.ip_address(member.get(field)).version == 4, "peer_registry_member_invalid")
        except ValueError:
            fail("peer_registry_member_invalid")
    for field in ("transport_ipv6", "transport_gateway_ipv6", "application_ipv6"):
        try:
            require(ipaddress.ip_address(member.get(field)).version == 6, "peer_registry_member_invalid")
        except ValueError:
            fail("peer_registry_member_invalid")
    require(member["application_route_ipv4"] == f"{member['application_ipv4']}/32" and member["application_route_ipv6"] == f"{member['application_ipv6']}/128", "peer_registry_member_invalid")
    try:
        require(ipaddress.ip_network(member["gateway_route_ipv4"], strict=False).prefixlen == 32 and ipaddress.ip_network(member["gateway_route_ipv6"], strict=False).prefixlen == 128, "peer_registry_member_invalid")
    except ValueError:
        fail("peer_registry_member_invalid")


def validate_target_shape(value: Any, target_key: str | None = None) -> dict[str, Any]:
    require(isinstance(value, dict), "peer_registry_target_invalid")
    expected = {"schema", "state", "target_key", "run_id", "container_id", "tenant_database_id", "database_generation", "restore_target", "endpoint_ipv4", "endpoint_ipv6", "gateway_ipv4", "gateway_ipv6", "database_namespace_inode", "loopback_aliases_present", "members", "detached_members"}
    require(set(value) == expected and value.get("schema") == TARGET_SCHEMA, "peer_registry_target_invalid")
    key = value.get("target_key")
    require(isinstance(key, str) and re.fullmatch(r"[0-9a-f]{64}", key) is not None and (target_key is None or key == target_key), "peer_registry_target_invalid")
    require(value.get("state") in {"preparing", "active", "empty"}, "peer_registry_target_invalid")
    validate_uuid(value.get("run_id"), "peer_registry_target_invalid")
    require(isinstance(value.get("container_id"), str) and CONTAINER_RE.fullmatch(value["container_id"]) is not None, "peer_registry_target_invalid")
    validate_uuid(value.get("tenant_database_id"), "peer_registry_target_invalid")
    validate_uuid(value.get("database_generation"), "peer_registry_target_invalid")
    require(isinstance(value.get("restore_target"), bool), "peer_registry_target_invalid")
    try:
        require(ipaddress.ip_address(value.get("endpoint_ipv4")).version == 4 and ipaddress.ip_address(value.get("gateway_ipv4")).version == 4 and ipaddress.ip_address(value.get("endpoint_ipv6")).version == 6 and ipaddress.ip_address(value.get("gateway_ipv6")).version == 6, "peer_registry_target_invalid")
    except ValueError:
        fail("peer_registry_target_invalid")
    validate_positive(value.get("database_namespace_inode"), "peer_registry_target_invalid")
    require(isinstance(value.get("loopback_aliases_present"), bool) and isinstance(value.get("members"), list) and isinstance(value.get("detached_members"), list), "peer_registry_target_invalid")
    seen: set[tuple[str, int, int]] = set()
    require(len(value["members"]) <= MAX_MEMBERS and len(value["detached_members"]) <= MAX_MEMBERS, "peer_registry_target_invalid")
    used_interfaces: set[str] = set()
    used_gateways: set[str] = set()
    used_transport4: set[str] = set()
    used_transport6: set[str] = set()
    for member in value["members"]:
        validate_member_shape(member)
        member_key = (member["allocation_id"], member["runtime_generation"], member["runtime_fence"])
        require(member_key not in seen, "peer_registry_target_invalid")
        require(member["interface"] not in used_interfaces and member["gateway_interface"] not in used_gateways, "peer_registry_target_invalid")
        require(not ({member["transport_ipv4"], member["transport_gateway_ipv4"]} & used_transport4) and not ({member["transport_ipv6"], member["transport_gateway_ipv6"]} & used_transport6), "peer_registry_target_invalid")
        seen.add(member_key)
        used_interfaces.add(member["interface"])
        used_gateways.add(member["gateway_interface"])
        used_transport4.update((member["transport_ipv4"], member["transport_gateway_ipv4"]))
        used_transport6.update((member["transport_ipv6"], member["transport_gateway_ipv6"]))
    detached_seen: set[tuple[str, int, int]] = set()
    for member in value["detached_members"]:
        validate_member_shape(member)
        member_key = (member["allocation_id"], member["runtime_generation"], member["runtime_fence"])
        require(member_key not in detached_seen and member_key not in seen, "peer_registry_target_invalid")
        detached_seen.add(member_key)
    require((value["state"] == "active") == bool(value["members"]), "peer_registry_target_invalid")
    require(value["state"] != "empty" or (not value["members"] and value["loopback_aliases_present"] is False and value["detached_members"]), "peer_registry_target_invalid")
    return value


def attachment_key(target_key: str, request: dict[str, Any]) -> str:
    return hash_text(":".join((target_key, request["allocation_id"], str(request["runtime_generation"]), str(request["runtime_fence"]))))


def planned_mac(target_key: str, side: str) -> str:
    raw = bytearray.fromhex(hash_text(f"{target_key}:{side}")[:12])
    raw[0] = (raw[0] | 0x02) & 0xFE
    return ":".join(f"{value:02x}" for value in raw)


def validate_identity_triplet(value: Any, error: str = "peer_attachment_invalid") -> None:
    require(isinstance(value, list) and len(value) == 3, error)
    validate_positive(value[0], error)
    validate_positive(value[1], error)
    require(isinstance(value[2], str) and MAC_RE.fullmatch(value[2]) is not None, error)


def validate_attachment_shape(value: Any, attachment_key_value: str | None = None) -> dict[str, Any]:
    require(isinstance(value, dict), "peer_attachment_invalid")
    expected = {
        "schema", "state", "target_key", "allocation_id", "runtime_generation", "runtime_fence",
        "run_id", "container_id", "tenant_database_id", "database_generation", "restore_target",
        "database_namespace_inode", "gateway_namespace_inode", "pid", "endpoint_ipv4", "endpoint_ipv6",
        "gateway_ipv4", "gateway_ipv6", "application_ipv4", "application_ipv6", "interface",
        "gateway_interface", "interface_mac", "gateway_interface_mac", "transport_ipv4",
        "transport_gateway_ipv4", "transport_ipv6", "transport_gateway_ipv6", "target_created",
        "target_before", "alias4", "alias6", "veth", "host_interface_identity", "host_gateway_identity",
        "route_states", "member", "peer_written",
    }
    require(set(value) == expected and value.get("schema") == ATTACHMENT_SCHEMA, "peer_attachment_invalid")
    key = value.get("target_key")
    require(isinstance(key, str) and re.fullmatch(r"[0-9a-f]{64}", key) is not None, "peer_attachment_invalid")
    if attachment_key_value is not None:
        require(re.fullmatch(r"[0-9a-f]{64}", attachment_key_value) is not None, "peer_attachment_invalid")
        require(attachment_key(key, value) == attachment_key_value, "peer_attachment_invalid")
    require(value.get("state") in ATTACHMENT_PHASES, "peer_attachment_invalid")
    validate_uuid(value.get("allocation_id"), "peer_attachment_invalid")
    validate_uuid(value.get("run_id"), "peer_attachment_invalid")
    validate_uuid(value.get("tenant_database_id"), "peer_attachment_invalid")
    validate_uuid(value.get("database_generation"), "peer_attachment_invalid")
    require(isinstance(value.get("runtime_generation"), int) and not isinstance(value["runtime_generation"], bool) and value["runtime_generation"] > 0, "peer_attachment_invalid")
    require(isinstance(value.get("runtime_fence"), int) and not isinstance(value["runtime_fence"], bool) and value["runtime_fence"] > 0, "peer_attachment_invalid")
    require(isinstance(value.get("container_id"), str) and CONTAINER_RE.fullmatch(value["container_id"]) is not None, "peer_attachment_invalid")
    require(isinstance(value.get("restore_target"), bool) and isinstance(value.get("target_created"), bool) and isinstance(value.get("peer_written"), bool), "peer_attachment_invalid")
    for field in ("database_namespace_inode", "gateway_namespace_inode", "pid"):
        validate_positive(value.get(field), "peer_attachment_invalid")
    for field in ("endpoint_ipv4", "gateway_ipv4", "application_ipv4", "transport_ipv4", "transport_gateway_ipv4"):
        try:
            require(ipaddress.ip_address(value.get(field)).version == 4, "peer_attachment_invalid")
        except ValueError:
            fail("peer_attachment_invalid")
    for field in ("endpoint_ipv6", "gateway_ipv6", "application_ipv6", "transport_ipv6", "transport_gateway_ipv6"):
        try:
            require(ipaddress.ip_address(value.get(field)).version == 6, "peer_attachment_invalid")
        except ValueError:
            fail("peer_attachment_invalid")
    for field in ("interface", "gateway_interface"):
        require(isinstance(value.get(field), str) and IFACE_RE.fullmatch(value[field]) is not None, "peer_attachment_invalid")
    for field in ("interface_mac", "gateway_interface_mac"):
        require(isinstance(value.get(field), str) and MAC_RE.fullmatch(value[field]) is not None, "peer_attachment_invalid")
    require(value["interface_mac"] == planned_mac(key, "database") and value["gateway_interface_mac"] == planned_mac(key, "gateway"), "peer_attachment_invalid")
    target_before = value.get("target_before")
    require(target_before is None or isinstance(target_before, dict), "peer_attachment_invalid")
    if target_before is not None:
        validate_target_shape(target_before, key)
    require(value.get("alias4") in ATTACHMENT_EFFECT_PHASES and value.get("alias6") in ATTACHMENT_EFFECT_PHASES, "peer_attachment_invalid")
    require(value.get("veth") in ATTACHMENT_VETH_PHASES, "peer_attachment_invalid")
    for field in ("host_interface_identity", "host_gateway_identity"):
        identity = value.get(field)
        require(identity is None or isinstance(identity, list), "peer_attachment_invalid")
        if identity is not None:
            validate_identity_triplet(identity)
    route_states = value.get("route_states")
    require(isinstance(route_states, dict) and set(route_states) == set(ATTACHMENT_ROUTE_NAMES), "peer_attachment_invalid")
    require(all(route_states[name] in ATTACHMENT_EFFECT_PHASES for name in ATTACHMENT_ROUTE_NAMES), "peer_attachment_invalid")
    member = value.get("member")
    require(member is None or isinstance(member, dict), "peer_attachment_invalid")
    if member is not None:
        validate_member_shape(member)
        require(member["allocation_id"] == value["allocation_id"] and member["runtime_generation"] == value["runtime_generation"] and member["runtime_fence"] == value["runtime_fence"] and member["interface"] == value["interface"] and member["gateway_interface"] == value["gateway_interface"] and member["interface_mac"] == value["interface_mac"] and member["gateway_interface_mac"] == value["gateway_interface_mac"], "peer_attachment_invalid")
    return value


def member_from_peer(value: dict[str, Any]) -> dict[str, Any]:
    require(value.get("schema") == PEER_SCHEMA, "peer_record_invalid")
    member = value.get("member")
    validate_member_shape(member)
    return member


def validate_peer_shape(value: Any, request: dict[str, Any], target_key: str, pid: int, gateway_inode: str) -> dict[str, Any]:
    require(isinstance(value, dict), "peer_record_invalid")
    expected = {"schema", "allocation_id", "runtime_generation", "runtime_fence", "run_id", "container_id", "tenant_database_id", "database_generation", "restore_target", "target_key", "pid", "member"}
    require(set(value) == expected and value.get("schema") == PEER_SCHEMA, "peer_record_invalid")
    require(value.get("allocation_id") == request["allocation_id"] and value.get("runtime_generation") == request["runtime_generation"] and value.get("runtime_fence") == request["runtime_fence"], "peer_record_mismatch")
    require(value.get("run_id") == request["run_id"] and value.get("container_id") == request["container_id"] and value.get("tenant_database_id") == request["tenant_database_id"] and value.get("database_generation") == request["database_generation"] and value.get("restore_target") == request["restore_target"] and value.get("target_key") == target_key, "peer_record_mismatch")
    validate_positive(value.get("pid"), "peer_record_invalid")
    require(value["pid"] == pid, "peer_record_mismatch")
    member = member_from_peer(value)
    require(member["allocation_id"] == request["allocation_id"] and member["runtime_generation"] == request["runtime_generation"] and member["runtime_fence"] == request["runtime_fence"] and member["container_id"] == request["container_id"] and str(member["gateway_namespace_inode"]) == gateway_inode and str(member["database_namespace_inode"]) == str(os.stat(f"/proc/{pid}/ns/net").st_ino), "peer_record_mismatch")
    return value


def target_identity(request: dict[str, Any]) -> str:
    raw = ":".join((request["run_id"], request["container_id"], request["tenant_database_id"], request["database_generation"], "true" if request["restore_target"] else "false", request["endpoint_ipv4"], request["endpoint_ipv6"], request["gateway_ipv4"], request["gateway_ipv6"]))
    return hash_text(raw)


class Registry:
    def __init__(self, state_root: Path) -> None:
        self.root = state_root / REGISTRY_NAME
        self.targets = self.root / "targets"
        self.attachments = self.root / "attachments"
        self.lock_path = self.root / ".lock"
        self.lock_fd: int | None = None

    def prepare(self) -> None:
        if self.root.exists() or self.root.is_symlink():
            validate_owned_directory(self.root, "peer_registry_permissions_invalid")
        else:
            make_owned_directory(self.root)
        if self.targets.exists() or self.targets.is_symlink():
            validate_owned_directory(self.targets, "peer_registry_permissions_invalid")
        else:
            make_owned_directory(self.targets)
        if self.attachments.exists() or self.attachments.is_symlink():
            validate_owned_directory(self.attachments, "peer_registry_permissions_invalid")
        else:
            make_owned_directory(self.attachments)
        try:
            self.lock_fd = os.open(self.lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
            os.fchmod(self.lock_fd, 0o600)
            if os.geteuid() == 0:
                os.fchown(self.lock_fd, 0, 0)
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX)
        except OSError:
            fail("peer_registry_lock_failed")
        require(is_regular(self.lock_path) and exact_realpath(self.lock_path) and owner(self.lock_path) == 0 and mode(self.lock_path) == 0o600, "peer_registry_lock_invalid")
        for child in self.targets.iterdir():
            require(not child.is_symlink() and child.name.endswith(".json") and re.fullmatch(r"[0-9a-f]{64}\.json", child.name) is not None and is_regular(child) and exact_realpath(child) and owner(child) == 0 and mode(child) == 0o600, "peer_registry_child_invalid")
        for child in self.attachments.iterdir():
            require(not child.is_symlink() and child.name.endswith(".json") and re.fullmatch(r"[0-9a-f]{64}\.json", child.name) is not None and is_regular(child) and exact_realpath(child) and owner(child) == 0 and mode(child) == 0o600, "peer_registry_attachment_invalid")

    def close(self) -> None:
        if self.lock_fd is not None:
            try:
                fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
                os.close(self.lock_fd)
            except OSError:
                pass
            self.lock_fd = None

    def target_path(self, key: str) -> Path:
        require(re.fullmatch(r"[0-9a-f]{64}", key) is not None, "peer_registry_target_invalid")
        return self.targets / f"{key}.json"

    def load_target(self, key: str) -> dict[str, Any] | None:
        path = self.target_path(key)
        if not path.exists() and not path.is_symlink():
            return None
        require(is_regular(path) and exact_realpath(path) and owner(path) == 0 and mode(path) == 0o600, "peer_registry_target_invalid")
        return validate_target_shape(read_json(path), key)

    def write_target(self, target: dict[str, Any]) -> None:
        validate_target_shape(target, target["target_key"])
        atomic_write_json(self.target_path(target["target_key"]), target)

    def remove_target(self, key: str) -> None:
        path = self.target_path(key)
        require(is_regular(path) and exact_realpath(path), "peer_registry_target_invalid")
        try:
            path.unlink()
        except OSError:
            fail("peer_registry_target_remove_failed")

    def all_targets(self) -> list[dict[str, Any]]:
        values = []
        for child in self.targets.iterdir():
            require(not child.is_symlink() and re.fullmatch(r"[0-9a-f]{64}\.json", child.name) is not None and is_regular(child) and exact_realpath(child) and owner(child) == 0 and mode(child) == 0o600, "peer_registry_child_invalid")
            values.append(validate_target_shape(read_json(child), child.stem))
        return values

    def attachment_path(self, key: str) -> Path:
        require(re.fullmatch(r"[0-9a-f]{64}", key) is not None, "peer_attachment_invalid")
        return self.attachments / f"{key}.json"

    def load_attachment(self, key: str) -> dict[str, Any] | None:
        path = self.attachment_path(key)
        if not path.exists() and not path.is_symlink():
            return None
        require(is_regular(path) and exact_realpath(path) and owner(path) == 0 and mode(path) == 0o600, "peer_attachment_invalid")
        return validate_attachment_shape(read_json(path), key)

    def write_attachment(self, value: dict[str, Any]) -> None:
        validate_attachment_shape(value, attachment_key(value["target_key"], value))
        atomic_write_json(self.attachment_path(attachment_key(value["target_key"], value)), value)

    def remove_attachment(self, value_or_key: dict[str, Any] | str) -> None:
        key = value_or_key if isinstance(value_or_key, str) else attachment_key(value_or_key["target_key"], value_or_key)
        path = self.attachment_path(key)
        require(is_regular(path) and exact_realpath(path), "peer_attachment_invalid")
        try:
            path.unlink()
        except OSError:
            fail("peer_attachment_remove_failed")

    def all_attachments(self) -> list[dict[str, Any]]:
        values = []
        for child in self.attachments.iterdir():
            require(not child.is_symlink() and re.fullmatch(r"[0-9a-f]{64}\.json", child.name) is not None and is_regular(child) and exact_realpath(child) and owner(child) == 0 and mode(child) == 0o600, "peer_registry_attachment_invalid")
            values.append(validate_attachment_shape(read_json(child), child.stem))
        return values


@contextlib.contextmanager
def locked_registry(state_root: Path) -> Iterator[Registry]:
    registry = Registry(state_root)
    registry.prepare()
    try:
        yield registry
    finally:
        registry.close()


def transport_candidate(registry: Registry, allocation: str, generation: int, fence: int, pid: int) -> tuple[str, str, str, str]:
    used4: set[str] = set()
    used6: set[str] = set()
    for target in registry.all_targets():
        for member in target["members"]:
            used4.update((member["transport_ipv4"], member["transport_gateway_ipv4"]))
            used6.update((member["transport_ipv6"], member["transport_gateway_ipv6"]))
    for attachment in registry.all_attachments():
        used4.update((attachment["transport_ipv4"], attachment["transport_gateway_ipv4"]))
        used6.update((attachment["transport_ipv6"], attachment["transport_gateway_ipv6"]))
    addresses = local_addresses(addresses_pid(pid))
    seed = int(hash_text(f"{allocation}:{generation}:{fence}")[:8], 16) % 16384
    for offset in range(16384):
        slot = (seed + offset) % 16384
        base4 = ipaddress.ip_address("10.250.0.0") + slot * 4
        endpoint4 = str(base4 + 2)
        gateway4 = str(base4 + 1)
        endpoint6 = str(ipaddress.ip_address(f"fd77:250:{slot:x}::2"))
        gateway6 = str(ipaddress.ip_address(f"fd77:250:{slot:x}::1"))
        if endpoint4 in used4 or gateway4 in used4 or endpoint6 in used6 or gateway6 in used6:
            continue
        if endpoint4 in addresses or gateway4 in addresses or endpoint6 in addresses or gateway6 in addresses:
            continue
        if route_entries_pid(pid, endpoint4, 4) or route_entries_pid(pid, endpoint6, 6):
            continue
        return endpoint4, gateway4, endpoint6, gateway6
    fail("peer_transport_pool_exhausted")


