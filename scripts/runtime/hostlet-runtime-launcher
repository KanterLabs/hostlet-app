record_network_veth_ownership() {
  local ownership=$1 app_name="a${short}" gateway_name="g${short}" app_json gateway_json app_ifindex gateway_ifindex app_peer_ifindex gateway_peer_ifindex app_mac gateway_mac temporary
  [[ -f "$ownership" && ! -L "$ownership" ]] || return 1
  app_json=$(network_link_json "$app_ns" "$app_name") || return 1
  gateway_json=$(network_link_json "$gateway_ns" "$gateway_name") || return 1
  app_ifindex=$(jq -er --arg name "$app_name" 'if length == 1 and .[0].ifname == $name and .[0].linkinfo.info_kind == "veth" and (.[0].ifindex|type == "number") and .[0].ifindex > 0 then .[0].ifindex else error("veth_identity_invalid") end' <<<"$app_json") || return 1
  gateway_ifindex=$(jq -er --arg name "$gateway_name" 'if length == 1 and .[0].ifname == $name and .[0].linkinfo.info_kind == "veth" and (.[0].ifindex|type == "number") and .[0].ifindex > 0 then .[0].ifindex else error("veth_identity_invalid") end' <<<"$gateway_json") || return 1
  app_peer_ifindex=$(jq -er 'if length == 1 and (.[0].link_index|type == "number") and .[0].link_index > 0 then .[0].link_index else error("veth_peer_ifindex_invalid") end' <<<"$app_json") || return 1
