mount_runtime_rootfs() {
  [[ -d "$rootfs" && ! -L "$rootfs" ]] || { echo runtime_rootfs_invalid >&2; return 1; }
  rootfs_source_inode=$(stat -Lc %i "$rootfs")
  [[ "$rootfs_source_inode" =~ ^[1-9][0-9]*$ ]] || { echo runtime_rootfs_invalid >&2; return 1; }
  mount --bind -- "$rootfs" "$rootfs_mount"
  rootfs_mount_identity=$(mount_identity "$rootfs_mount")
  rootfs_target_inode=$(stat -Lc %i "$rootfs_mount")
