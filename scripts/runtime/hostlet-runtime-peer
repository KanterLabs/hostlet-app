CONTAINER_RE = re.compile(r"^[0-9a-f]{64}$")
IFACE_RE = re.compile(r"^[pd][0-9a-f]{10}$")
MAC_RE = re.compile(r"^[0-9a-f]{2}(?::[0-9a-f]{2}){5}$")
POSITIVE_FIELDS = ("database_namespace_inode", "gateway_namespace_inode", "interface_ifindex", "gateway_interface_ifindex", "interface_peer_ifindex", "gateway_interface_peer_ifindex")
MEMBER_FIELDS = frozenset(("allocation_id", "runtime_generation", "runtime_fence", "container_id", "database_namespace_inode", "gateway_namespace_inode", "interface", "gateway_interface", "interface_ifindex", "gateway_interface_ifindex", "interface_peer_ifindex", "gateway_interface_peer_ifindex", "interface_mac", "gateway_interface_mac", "transport_ipv4", "transport_ipv6", "transport_gateway_ipv4", "transport_gateway_ipv6", "application_ipv4", "application_ipv6", "application_route_ipv4", "application_route_ipv6", "gateway_route_ipv4", "gateway_route_ipv6"))
ATTACHMENT_ROUTE_NAMES = ("gateway_ipv4", "gateway_ipv6", "application_ipv4", "application_ipv6")
ATTACHMENT_PHASES = {"preparing", "ready", "committing", "rollback"}
ATTACHMENT_EFFECT_PHASES = {"absent", "adding", "owned"}
ATTACHMENT_VETH_PHASES = {"absent", "creating", "host", "gateway_moved", "database_moved", "ready"}
MAX_MEMBERS = 256


class PeerError(Exception):
    def __init__(self, message: str, status: int = 1) -> None:
        super().__init__(message)
        self.message = message
        self.status = status


class CommandError(Exception):
    pass


def fail(message: str, status: int = 1) -> None:
    raise PeerError(message, status)


def require(condition: bool, message: str, status: int = 1) -> None:
    if not condition:
        fail(message, status)


def is_regular(path: Path) -> bool:
    try:
        return stat.S_ISREG(os.lstat(path).st_mode)
    except OSError:
        return False


def is_directory(path: Path) -> bool:
    try:
        return stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def exact_realpath(path: Path) -> bool:
    try:
        return os.path.realpath(path) == str(path)
    except OSError:
        return False


def mode(path: Path) -> int:
    return stat.S_IMODE(os.lstat(path).st_mode)


def owner(path: Path) -> int:
    return os.lstat(path).st_uid


def read_json(path: Path) -> Any:
    require(is_regular(path) and exact_realpath(path) and owner(path) == 0 and mode(path) == 0o600, "peer_record_permissions_invalid")
    fd = None
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        opened = os.fstat(fd)
        require(stat.S_ISREG(opened.st_mode) and opened.st_uid == 0 and stat.S_IMODE(opened.st_mode) == 0o600, "peer_record_permissions_invalid")
        with os.fdopen(fd, "rb") as handle:
            fd = None
            return json.loads(handle.read().decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        fail("peer_record_invalid")
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass


def run_command(args: list[str], timeout: float = 15.0) -> str:
    try:
        result = subprocess.run(args, env=SAFE_ENV, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise CommandError from None
    if result.returncode != 0:
        raise CommandError
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError:
        raise CommandError from None


def run_json(args: list[str], timeout: float = 15.0) -> Any:
    try:
        return json.loads(run_command(args, timeout))
    except (CommandError, json.JSONDecodeError):
        raise CommandError from None


def ns_command(pid: int, args: list[str]) -> list[str]:
    return [NSENTER, "-t", str(pid), "-n", *args]


def ns_json(pid: int, args: list[str]) -> Any:
    return run_json(ns_command(pid, args))


def gateway_command(namespace: str, args: list[str]) -> list[str]:
    return [IP, "-n", namespace, *args]


def gateway_json(namespace: str, args: list[str]) -> Any:
    return run_json(gateway_command(namespace, args))


def hash_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def atomic_write_json(path: Path, value: Any, expected_mode: int = 0o600) -> None:
    require(is_directory(path.parent) and exact_realpath(path.parent), "peer_record_parent_invalid")
    temporary: Path | None = None
    try:
        fd, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.tmp-", dir=path.parent)
        temporary = Path(temporary_name)
        os.fchmod(fd, expected_mode)
        if os.geteuid() == 0:
            os.fchown(fd, 0, 0)
        payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
        with os.fdopen(fd, "wb") as handle:
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        temporary = None
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    except OSError:
        fail("peer_record_write_failed")
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass


def make_owned_directory(path: Path) -> None:
    try:
        path.mkdir(mode=0o700)
        if os.geteuid() == 0:
            os.chown(path, 0, 0)
        os.chmod(path, 0o700)
    except FileExistsError:
        pass
    except OSError:
        fail("peer_registry_create_failed")
    validate_owned_directory(path, "peer_registry_permissions_invalid")


def validate_owned_directory(path: Path, error: str) -> None:
    require(is_directory(path) and not path.is_symlink() and exact_realpath(path), error)
    require(owner(path) == 0 and mode(path) == 0o700, error)


def validate_uuid(value: Any, error: str = "peer_identity_invalid") -> str:
    require(isinstance(value, str) and UUID_RE.fullmatch(value) is not None, error, 2)
    return value


def validate_positive(value: Any, error: str) -> int:
    require(isinstance(value, int) and not isinstance(value, bool) and value > 0, error)
    return value


def parse_request(source: Path, digest: str, state_root: Path) -> tuple[dict[str, Any], Path]:
    require(source.is_absolute() and state_root.is_absolute(), "peer_usage", 2)
    require(re.fullmatch(r"[0-9a-f]{64}", digest) is not None, "peer_usage", 2)
    require(is_regular(source) and exact_realpath(source), "peer_root_not_owned", 2)
    marker = state_root / ".hostlet-runtime-owned"
    require(is_directory(state_root) and not state_root.is_symlink() and exact_realpath(state_root), "peer_root_not_owned", 2)
    require(is_regular(marker) and exact_realpath(marker), "peer_root_not_owned", 2)
    try:
        require(marker.read_text(encoding="utf-8").rstrip("\n") == STATE_MARKER, "peer_root_not_owned", 2)
    except OSError:
        fail("peer_root_not_owned", 2)
    temporary: Path | None = None
    try:
        fd, name = tempfile.mkstemp(prefix=".peer-request.", dir=state_root)
        temporary = Path(name)
        os.fchmod(fd, 0o400)
        if os.geteuid() == 0:
            os.fchown(fd, 0, 0)
        with source.open("rb") as input_handle, os.fdopen(fd, "wb") as output_handle:
            payload = input_handle.read()
            output_handle.write(payload)
            output_handle.flush()
            os.fsync(output_handle.fileno())
        require(hashlib.sha256(payload).hexdigest() == digest, "peer_request_digest_mismatch", 2)
        try:
            request = json.loads(payload.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            fail("peer_request_invalid", 2)
        require(isinstance(request, dict), "peer_request_invalid", 2)
        require(request.get("schema") == REQUEST_SCHEMA and request.get("operation") in {"attach_postgres", "detach_postgres"}, "peer_request_invalid", 2)
        return request, temporary
    except OSError:
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass
        fail("peer_request_invalid", 2)
    except PeerError:
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass
        raise


def validate_request(request: dict[str, Any]) -> dict[str, Any]:
    required = ("allocation_id", "runtime_generation", "runtime_fence", "container_id", "run_id", "tenant_database_id", "database_generation", "restore_target", "endpoint_ipv4", "endpoint_ipv6", "gateway_ipv4", "gateway_ipv6")
    require(all(name in request for name in required), "peer_request_invalid", 2)
    for name in ("allocation_id", "run_id", "tenant_database_id", "database_generation"):
        validate_uuid(request[name])
    require(isinstance(request["runtime_generation"], int) and not isinstance(request["runtime_generation"], bool) and request["runtime_generation"] > 0, "peer_identity_invalid", 2)
    require(isinstance(request["runtime_fence"], int) and not isinstance(request["runtime_fence"], bool) and request["runtime_fence"] > 0, "peer_identity_invalid", 2)
    require(isinstance(request["container_id"], str) and CONTAINER_RE.fullmatch(request["container_id"]) is not None, "peer_identity_invalid", 2)
    require(isinstance(request["restore_target"], bool), "peer_identity_invalid", 2)
    require(all(isinstance(request[name], str) for name in ("endpoint_ipv4", "endpoint_ipv6", "gateway_ipv4", "gateway_ipv6")), "peer_endpoint_invalid", 2)
    try:
        endpoint4 = ipaddress.ip_address(request["endpoint_ipv4"])
        gateway4 = ipaddress.ip_address(request["gateway_ipv4"])
        endpoint6 = ipaddress.ip_address(request["endpoint_ipv6"])
        gateway6 = ipaddress.ip_address(request["gateway_ipv6"])
    except ValueError:
        fail("peer_endpoint_invalid", 2)
    require(endpoint4.version == gateway4.version == 4 and endpoint6.version == gateway6.version == 6, "peer_endpoint_invalid", 2)
    require(endpoint4 != gateway4 and endpoint6 != gateway6, "peer_endpoint_invalid", 2)
    network4 = ipaddress.ip_network(f"{endpoint4}/30", strict=False)
    network6 = ipaddress.ip_network(f"{endpoint6}/126", strict=False)
    require(gateway4 in network4 and gateway6 in network6, "peer_endpoint_invalid", 2)
    require(endpoint4 not in {network4.network_address, network4.broadcast_address} and gateway4 not in {network4.network_address, network4.broadcast_address}, "peer_endpoint_invalid", 2)
    require(endpoint6 not in {network6.network_address, network6.broadcast_address} and gateway6 not in {network6.network_address, network6.broadcast_address}, "peer_endpoint_invalid", 2)
    return request


def inspect_container(container: str, request: dict[str, Any]) -> tuple[int, str]:
    try:
        inspected = run_json([DOCKER, "inspect", container], 15.0)
    except CommandError:
        fail("peer_container_invalid")
    require(isinstance(inspected, list) and len(inspected) == 1 and isinstance(inspected[0], dict), "peer_container_invalid")
    value = inspected[0]
    require(value.get("Id") == container and value.get("State", {}).get("Running") is True and value.get("HostConfig", {}).get("NetworkMode") == "none", "peer_container_invalid")
    labels = value.get("Config", {}).get("Labels")
    require(isinstance(labels, dict), "peer_container_labels_invalid")
    expected = {
        "io.hostlet.scope": "m3-e2e",
        "io.hostlet.run-id": request["run_id"],
        "io.hostlet.resource": "tenant-postgres",
        "io.hostlet.database-id": request["tenant_database_id"],
        "io.hostlet.database-generation": request["database_generation"],
        "io.hostlet.restore-target": "true" if request["restore_target"] else "false",
    }
    require(all(labels.get(key) == value for key, value in expected.items()), "peer_container_labels_invalid")
    try:
        pid = int(value.get("State", {}).get("Pid"))
    except (TypeError, ValueError):
        fail("peer_container_invalid")
    require(pid > 0 and Path(f"/proc/{pid}").is_dir(), "peer_container_invalid")
    try:
        namespace_inode = os.stat(f"/proc/{pid}/ns/net").st_ino
    except OSError:
        fail("peer_container_namespace_invalid")
    return pid, str(namespace_inode)


def validate_ownership(state_root: Path, request: dict[str, Any], gateway_ns: str) -> tuple[Path, dict[str, Any], str]:
    allocation = request["allocation_id"]
    generation = request["runtime_generation"]
    allocation_root = state_root / allocation
    generation_root = state_root / allocation / str(generation)
    ownership_path = generation_root / "OWNERSHIP.json"
    require(is_directory(allocation_root) and not allocation_root.is_symlink() and exact_realpath(allocation_root) and owner(allocation_root) == 0 and mode(allocation_root) == 0o700, "peer_runtime_not_owned")
    require(is_directory(generation_root) and not generation_root.is_symlink() and exact_realpath(generation_root) and owner(generation_root) == 0 and mode(generation_root) == 0o700, "peer_runtime_not_owned")
    require(is_regular(ownership_path) and exact_realpath(ownership_path) and owner(ownership_path) == 0 and mode(ownership_path) == 0o600, "peer_runtime_not_owned")
    ownership = read_json(ownership_path)
    require(isinstance(ownership, dict) and ownership.get("allocation_id") == allocation and ownership.get("generation") == generation and ownership.get("fence") == request["runtime_fence"], "peer_runtime_fence_mismatch")
    gateway_path = Path("/run/netns") / gateway_ns
    require(is_regular(gateway_path) and exact_realpath(gateway_path), "peer_runtime_not_owned")
    try:
        gateway_inode = os.stat(gateway_path).st_ino
    except OSError:
        fail("peer_runtime_not_owned")
    require(str(gateway_inode) == str(ownership.get("gateway_namespace_inode")), "peer_namespace_mismatch")
    return generation_root, ownership, str(gateway_inode)


def validate_outbound_and_app(ownership: dict[str, Any], request: dict[str, Any]) -> tuple[str, str]:
    destinations = ownership.get("outbound_destinations")
    require(isinstance(destinations, list), "peer_endpoint_not_allowed")
    allowed = {(item.get("address"), item.get("port"), item.get("protocol")) for item in destinations if isinstance(item, dict)}
    require((request["endpoint_ipv4"], 5432, "tcp") in allowed and (request["endpoint_ipv6"], 5432, "tcp") in allowed, "peer_endpoint_not_allowed")
    app4 = ownership.get("application_ipv4")
    app6 = ownership.get("application_ipv6")
    try:
        require(ipaddress.ip_address(app4).version == 4 and ipaddress.ip_address(app6).version == 6, "peer_application_endpoint_invalid")
    except ValueError:
        fail("peer_application_endpoint_invalid")
    return app4, app6


