      [[ "$result" == passed ]] || exit 1
      exit 0
    fi
    [[ -f "$generation_root/OWNERSHIP.json" && ! -L "$generation_root/OWNERSHIP.json" ]] || { echo runtime_ownership_missing >&2; exit 1; }
    jq -e --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" --arg identity_sha "$request_identity_sha256" --arg cgroup_identity "$cgroup_identity_hash" '.allocation_id==$id and .generation==$generation and .fence==$fence and .request_identity_sha256==$identity_sha and .cgroup_identity_hash==$cgroup_identity' "$generation_root/OWNERSHIP.json" >/dev/null || { echo runtime_ownership_mismatch >&2; exit 1; }
    load_cgroup_state || { emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; }
    validate_recorded_mounts "$generation_root/OWNERSHIP.json" cleanup || { emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; }
    expected_app=$(jq -r '.application_namespace_inode // empty' "$generation_root/OWNERSHIP.json"); expected_gateway=$(jq -r '.gateway_namespace_inode // empty' "$generation_root/OWNERSHIP.json")
    if [[ -e "/run/netns/$app_ns" && "$(stat -Lc %i "/run/netns/$app_ns")" != "$expected_app" ]]; then emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; fi
    if [[ -e "/run/netns/$gateway_ns" && "$(stat -Lc %i "/run/netns/$gateway_ns")" != "$expected_gateway" ]]; then emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; fi
