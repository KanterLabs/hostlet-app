    elif [[ "$mode" == cleanup ]]; then
      mount_target_empty "$secret_mount" || { echo runtime_secret_mount_invalid >&2; return 1; }
    else
      echo runtime_secret_mount_invalid >&2; return 1
    fi
  else
    if [[ "$mode" == cleanup ]]; then
      mount_target_empty "$secret_mount" || { echo runtime_secret_mount_invalid >&2; return 1; }
    else
      [[ ! -e "$secret_mount" ]] || { echo runtime_secret_mount_invalid >&2; return 1; }
    fi
  fi
}

partial_mount_cleanup() {
  set +e
  local identity target_inode
  if [[ -e "$secret_mount" ]]; then
    identity=${secret_mount_identity:-}
    target_inode=${secret_target_inode:-}
    if [[ -z "$identity" ]] && mountpoint -q "$secret_mount"; then identity=$(mount_identity "$secret_mount"); fi
    if [[ -z "$target_inode" && -e "$secret_mount" ]]; then target_inode=$(stat -Lc %i "$secret_mount" 2>/dev/null); fi
    if [[ -n "$identity" ]]; then
      unmount_recorded_mount "$secret_mount" "$identity" secret tmpfs "" "$target_inode"
    elif ! mountpoint -q "$secret_mount" && [[ -z "$(find "$secret_mount" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
      rmdir -- "$secret_mount"
    fi
  fi
  if [[ -e "$rootfs_mount" ]]; then
    identity=${rootfs_mount_identity:-}
    target_inode=${rootfs_target_inode:-}
    if [[ -z "$identity" ]] && mountpoint -q "$rootfs_mount"; then identity=$(mount_identity "$rootfs_mount"); fi
    if [[ -z "$target_inode" && -e "$rootfs_mount" ]]; then target_inode=$(stat -Lc %i "$rootfs_mount" 2>/dev/null); fi
    if [[ -n "$identity" ]]; then
