      "$runsc" "${global[@]}" state "$sandbox" > "$evidence/runsc-exit-state.json" 2>/dev/null || rm -f -- "$evidence/runsc-exit-state.json"
      exit_observed=$(observe_cgroup "$evidence/runsc-exit-state.json")
      if [[ "$exit_observed" != null ]]; then
        printf '%s\n' "$exit_observed" > "$evidence/last-observed.json"
        [[ "$(jq -r '.cpu_nr_throttled > 0' <<<"$exit_observed")" == true ]] && exit_reason=cpu_throttled
        [[ "$(jq -r '.pids_events.max > 0' <<<"$exit_observed")" == true ]] && exit_reason=process_limit_exceeded
        [[ "$(jq -r '.memory_events.oom_kill > 0' <<<"$exit_observed")" == true ]] && exit_reason=runtime_oom
      fi
      cutoff=$((now-600)); jq --argjson now "$now" --argjson cutoff "$cutoff" '.exits=([.exits[]|select(. >= $cutoff)]+[$now])|.healthy_since=null' "$restart_file" > "$restart_file.new"; mv "$restart_file.new" "$restart_file"; count=$(jq '.exits|length' "$restart_file")
      if (( count > 6 )); then emit crash_loop_backoff crash_loop_backoff false; exit 0; fi
      delays=(1 2 4 8 16 30); delay=${delays[$((count-1))]}; sleep "$delay"
      if ! runsc_quiet delete --force "$sandbox"; then
        emit restart_scheduled runtime_internal_failure false failed
        exit 1
      fi
      if ! advance_budget_epoch || ! update_cgroup_config_path || ! create_budget_cgroup; then
        emit restart_scheduled runtime_isolation_unverified false failed
        exit 1
      fi
      if ! runsc_quiet create --bundle "$bundle" "$sandbox"; then
        emit restart_scheduled runtime_internal_failure false failed
        exit 1
      fi
      if ! configure_cgroup; then
        runsc_quiet delete --force "$sandbox" || true
        emit restart_scheduled runtime_internal_failure false failed
        exit 1
      fi
      if ! restore_application_network; then
        runsc_quiet delete --force "$sandbox" || true
        emit restart_scheduled runtime_isolation_unverified false failed
        exit 1
      fi
      if ! runsc_quiet start "$sandbox"; then
        runsc_quiet delete --force "$sandbox" || true
        emit restart_scheduled runtime_internal_failure false failed
        exit 1
      fi
      # The reason belongs to the retired epoch; observed_limits comes only
      # from the newly created epoch and cannot inherit old events.
      emit restart_scheduled "$exit_reason" false
    fi;;
  stop)
    if "$runsc" "${global[@]}" state "$sandbox" > "$evidence/runsc-state.json" 2>/dev/null; then
      state=$(jq -r .status "$evidence/runsc-state.json")
      case "$state" in
        running)
          stop_observed=$(observe_cgroup "$evidence/runsc-state.json")
          [[ "$stop_observed" == null ]] || printf '%s\n' "$stop_observed" > "$evidence/last-observed.json"
          if ! runsc_quiet kill "$sandbox" TERM; then
            state=$("$runsc" "${global[@]}" state "$sandbox" 2>/dev/null | jq -r .status || true)
            [[ "$state" == stopped || "$state" == created || -z "$state" ]] || { emit cleanup_pending runtime_internal_failure false failed; exit 1; }
          fi
