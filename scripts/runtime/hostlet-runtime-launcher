      if [[ -n "$secret_mount_identity" ]]; then
        unmount_recorded_mount "$secret_mount" "$secret_mount_identity" secret tmpfs "" "$secret_target_inode" || failed=true
      else
        mount_target_empty "$secret_mount" || failed=true
      fi
    fi
    if [[ -n "$rootfs_mount_identity" ]]; then
      unmount_recorded_mount "$rootfs_mount" "$rootfs_mount_identity" rootfs "$rootfs" "$rootfs_source_inode" "$rootfs_target_inode" || failed=true
    else
      mount_target_empty "$rootfs_mount" || failed=true
    fi
