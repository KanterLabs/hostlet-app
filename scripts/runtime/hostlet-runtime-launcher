    cleanup_observed=$(observe_cgroup "")
    [[ "$cleanup_observed" == null ]] || printf '%s\n' "$cleanup_observed" > "$evidence/last-observed.json"
    remove_budget_cgroup || failed=true
    "$runsc" "${global[@]}" state "$sandbox" >/dev/null 2>&1 && failed=true
    cgroup_absent=false
    if load_cgroup_state && [[ ! -e "$cgroup_root" && ! -L "$cgroup_root" ]]; then cgroup_absent=true; else failed=true; fi
    [[ ! -e "/run/netns/$app_ns" && ! -e "/run/netns/$gateway_ns" && "$cgroup_absent" == true ]] || failed=true
    remove_mount_tuple || failed=true
    if [[ "$failed" == true ]]; then emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; fi
    write_cgroup_tombstone || { emit cleanup_pending runtime_cleanup_incomplete false failed; exit 1; }
    receipt=$(mktemp "${state_root}/.cleanup-receipt.XXXXXX"); emit cleaned runtime_cleaned > "$receipt"
    [[ "$generation_root" == "${state_root}/${id}/${generation}" ]] || exit 1
