def link_details(items: list[dict[str, Any]], name: str) -> dict[str, Any] | None:
    matches = [item for item in items if item.get("ifname") == name]
    require(len(matches) <= 1, "peer_interface_collision")
    return matches[0] if matches else None


def link_identity(item: dict[str, Any] | None, name: str, links: list[dict[str, Any]] | None = None) -> tuple[int, int, str]:
    require(item is not None and item.get("ifname") == name, "peer_interface_missing")
    try:
        index = int(item["ifindex"])
    except (KeyError, TypeError, ValueError):
        fail("peer_interface_invalid")
    peer_index_value = item.get("link_index")
    peer_item: dict[str, Any] | None = None
    if peer_index_value is None:
        peer_reference = item.get("link")
        if isinstance(peer_reference, str):
            peer_item = link_details(links or [], peer_reference)
            require(peer_item is not None, "peer_interface_invalid")
            peer_index_value = peer_item.get("ifindex")
        else:
            peer_index_value = peer_reference
    try:
        peer_index = int(peer_index_value)
    except (TypeError, ValueError):
        fail("peer_interface_invalid")
    address = item.get("address", "").lower()
    require(index > 0 and peer_index > 0 and MAC_RE.fullmatch(address) is not None, "peer_interface_invalid")
    if peer_item is not None:
        try:
            reciprocal = peer_item.get("link_index")
            if reciprocal is None and isinstance(peer_item.get("link"), str):
                reciprocal_item = link_details(links or [], peer_item["link"])
                require(reciprocal_item is not None and int(reciprocal_item.get("ifindex")) == index, "peer_interface_invalid")
            else:
                require(int(reciprocal) == index, "peer_interface_invalid")
        except (TypeError, ValueError):
            fail("peer_interface_invalid")
    return index, peer_index, address


