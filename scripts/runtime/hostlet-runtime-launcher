      validate_rootfs_mount "$rootfs_mount_identity" "$rootfs" "$rootfs_source_inode" "$rootfs_target_inode" || { echo runtime_rootfs_mount_invalid >&2; return 1; }
    elif [[ "$mode" == cleanup ]]; then
      mount_target_empty "$rootfs_mount" || { echo runtime_rootfs_mount_invalid >&2; return 1; }
    else
      echo runtime_rootfs_mount_invalid >&2; return 1
    fi
  fi
