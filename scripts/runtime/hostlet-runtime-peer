        "transport_gateway_ipv6": transport_gateway6,
        "target_created": target_created,
        "target_before": copy.deepcopy(target_before),
        "alias4": "absent",
        "alias6": "absent",
        "veth": "absent",
        "host_interface_identity": None,
        "host_gateway_identity": None,
        "route_states": {name: "absent" for name in ATTACHMENT_ROUTE_NAMES},
        "member": None,
        "peer_written": False,
    }


def validate_member_binding(pid: int, gateway_ns: str, member: dict[str, Any], request: dict[str, Any], gateway_inode: str) -> None:
    require(member["container_id"] == request["container_id"], "peer_registry_member_mismatch")
    try:
        database_inode = str(os.stat(f"/proc/{pid}/ns/net").st_ino)
        current_gateway_inode = str(os.stat(Path("/run/netns") / gateway_ns).st_ino)
    except OSError:
        fail("peer_namespace_mismatch")
    require(str(member["database_namespace_inode"]) == database_inode and str(member["gateway_namespace_inode"]) == current_gateway_inode == str(gateway_inode), "peer_namespace_mismatch")


def validate_member_current(pid: int, gateway_ns: str, member: dict[str, Any], request: dict[str, Any], gateway_inode: str) -> None:
    validate_member_binding(pid, gateway_ns, member, request, gateway_inode)
    db_links = link_list_pid(pid)
    gateway_links = link_list_gateway(gateway_ns)
    db_link = link_details(db_links, member["interface"])
    gateway_link = link_details(gateway_links, member["gateway_interface"])
    db_index, db_peer_index, db_mac = link_identity(db_link, member["interface"], db_links)
    gateway_index, gateway_peer_index, gateway_mac = link_identity(gateway_link, member["gateway_interface"], gateway_links)
    require(db_index == member["interface_ifindex"] and db_peer_index == member["interface_peer_ifindex"] and db_mac == member["interface_mac"], "peer_interface_mismatch")
    require(gateway_index == member["gateway_interface_ifindex"] and gateway_peer_index == member["gateway_interface_peer_ifindex"] and gateway_mac == member["gateway_interface_mac"], "peer_interface_mismatch")
    require(db_peer_index == gateway_index and gateway_peer_index == db_index, "peer_interface_mismatch")
    db_addresses = local_addresses(addresses_pid(pid))
    gateway_addresses = local_addresses(addresses_gateway(gateway_ns))
    require(db_addresses.get(member["transport_ipv4"]) == (member["interface"], 30) and db_addresses.get(member["transport_ipv6"]) == (member["interface"], 126), "peer_transport_mismatch")
    require(gateway_addresses.get(member["transport_gateway_ipv4"]) == (member["gateway_interface"], 30) and gateway_addresses.get(member["transport_gateway_ipv6"]) == (member["gateway_interface"], 126), "peer_transport_mismatch")
    require(route_matches(route_entries_gateway(gateway_ns, request["endpoint_ipv4"], 4), request["endpoint_ipv4"], member["transport_ipv4"], member["gateway_interface"], 4), "peer_route_mismatch")
    require(route_matches(route_entries_gateway(gateway_ns, request["endpoint_ipv6"], 6), request["endpoint_ipv6"], member["transport_ipv6"], member["gateway_interface"], 6), "peer_route_mismatch")
    require(route_matches(route_entries_pid(pid, member["application_ipv4"], 4), member["application_ipv4"], member["transport_gateway_ipv4"], member["interface"], 4), "peer_route_mismatch")
    require(route_matches(route_entries_pid(pid, member["application_ipv6"], 6), member["application_ipv6"], member["transport_gateway_ipv6"], member["interface"], 6), "peer_route_mismatch")
    present4, present6 = aliases_state(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])
    require(present4 and present6, "peer_alias_missing")


def aliases_state(pid: int, endpoint4: str, endpoint6: str) -> tuple[bool, bool]:
    values = local_addresses(addresses_pid(pid))
    for address in (endpoint4, endpoint6):
        if address in values and values[address][0] != "lo":
            fail("peer_endpoint_collision")
    return values.get(endpoint4) == ("lo", 32), values.get(endpoint6) == ("lo", 128)


def add_aliases(pid: int, endpoint4: str, endpoint6: str) -> tuple[bool, bool]:
    present4, present6 = aliases_state(pid, endpoint4, endpoint6)
    if not present4:
        try:
            run_command(ns_command(pid, [IP, "addr", "add", f"{endpoint4}/32", "dev", "lo"]))
        except CommandError:
            fail("peer_alias_add_failed")
    if not present6:
        try:
            run_command(ns_command(pid, [IP, "-6", "addr", "add", f"{endpoint6}/128", "dev", "lo", "nodad"]))
        except CommandError:
            fail("peer_alias_add_failed")
    after4, after6 = aliases_state(pid, endpoint4, endpoint6)
    require(after4 and after6, "peer_alias_missing")
    return not present4, not present6


def remove_aliases(pid: int, endpoint4: str, endpoint6: str) -> None:
    present4, present6 = aliases_state(pid, endpoint4, endpoint6)
    if present4:
        try:
            run_command(ns_command(pid, [IP, "addr", "del", f"{endpoint4}/32", "dev", "lo"]))
        except CommandError:
            fail("peer_alias_remove_failed")
    if present6:
        try:
            run_command(ns_command(pid, [IP, "-6", "addr", "del", f"{endpoint6}/128", "dev", "lo"]))
        except CommandError:
            fail("peer_alias_remove_failed")
    after4, after6 = aliases_state(pid, endpoint4, endpoint6)
    require(not after4 and not after6, "peer_alias_retained")


def route_target_present(entries: list[dict[str, Any]], target: str, gateway: str, interface: str, family: int) -> bool:
    return route_matches(entries, target, gateway, interface, family)


class AttachTransaction:
    def __init__(self, pid: int, gateway_ns: str, iface: str, gateway_iface: str, target: dict[str, Any], original_target: dict[str, Any] | None, target_created: bool, registry: Registry, generation_root: Path, peer_record: Path, request: dict[str, Any], attachment: dict[str, Any]) -> None:
        self.pid = pid
        self.gateway_ns = gateway_ns
        self.iface = iface
        self.gateway_iface = gateway_iface
        self.target = target
        self.original_target = copy.deepcopy(original_target)
        self.target_created = target_created
        self.registry = registry
        self.generation_root = generation_root
        self.peer_record = peer_record
        self.request = request
        self.attachment = attachment
        self.added_app4 = attachment["route_states"]["application_ipv4"] != "absent"
        self.added_app6 = attachment["route_states"]["application_ipv6"] != "absent"
        self.added_gateway4 = attachment["route_states"]["gateway_ipv4"] != "absent"
        self.added_gateway6 = attachment["route_states"]["gateway_ipv6"] != "absent"
        self.alias4 = attachment["alias4"] != "absent"
        self.alias6 = attachment["alias6"] != "absent"
        self.veth_created = attachment["veth"] != "absent"
        self.host_interface_identity: tuple[int, int, str] | None = tuple(attachment["host_interface_identity"]) if attachment["host_interface_identity"] is not None else None
        self.host_gateway_identity: tuple[int, int, str] | None = tuple(attachment["host_gateway_identity"]) if attachment["host_gateway_identity"] is not None else None
        self.peer_written = bool(attachment["peer_written"])
        self.member: dict[str, Any] | None = copy.deepcopy(attachment["member"])

    def journal(self, **changes: Any) -> None:
        self.attachment.update(changes)
        self.registry.write_attachment(self.attachment)

    def route_state(self, name: str, state: str) -> None:
        route_states = dict(self.attachment["route_states"])
        route_states[name] = state
        self.attachment["route_states"] = route_states
        self.registry.write_attachment(self.attachment)

    def _remove_route(self, name: str, target: str, gateway: str, interface: str, family: int, command: list[str]) -> bool:
        state = self.attachment["route_states"][name]
        if state == "absent":
            return True
        entries = route_entries_pid(self.pid, target, family) if command[0] == NSENTER else route_entries_gateway(self.gateway_ns, target, family)
        if entries and not route_target_present(entries, target, gateway, interface, family):
            return False
        if route_target_present(entries, target, gateway, interface, family):
            try:
                run_command(command)
            except CommandError:
                return False
            refreshed = route_entries_pid(self.pid, target, family) if command[0] == NSENTER else route_entries_gateway(self.gateway_ns, target, family)
            if route_target_present(refreshed, target, gateway, interface, family):
                return False
        self.route_state(name, "absent")
        return True

    def _link_matches(self, item: dict[str, Any] | None, name: str, links: list[dict[str, Any]], expected: tuple[int, int, str] | None, expected_mac: str) -> tuple[int, int, str] | None:
        if item is None:
            return None
        identity = link_identity(item, name, links)
        if expected is not None:
            require(identity == expected, "peer_partial_interface_mismatch")
        else:
            require(identity[2] == expected_mac, "peer_partial_interface_mismatch")
        return identity

    def rollback(self) -> bool:
        clean = True
        try:
            self.attachment["state"] = "rollback"
            self.registry.write_attachment(self.attachment)
        except PeerError:
            return False
        if self.peer_written or self.attachment.get("peer_written") or self.peer_record.exists():
            try:
                if self.peer_record.exists():
                    require(is_regular(self.peer_record) and exact_realpath(self.peer_record), "peer_record_invalid")
                    peer = read_json(self.peer_record)
                    validate_peer_shape(peer, self.request, self.attachment["target_key"], self.pid, str(self.attachment["gateway_namespace_inode"]))
                    self.peer_record.unlink()
                self.peer_written = False
                self.journal(peer_written=False)
            except (OSError, PeerError):
                clean = False
        route_specs = (
            ("application_ipv6", self.attachment["application_ipv6"], self.attachment["transport_gateway_ipv6"], self.iface, 6,
             ns_command(self.pid, [IP, "-6", "route", "del", f"{self.attachment['application_ipv6']}/128", "via", self.attachment["transport_gateway_ipv6"], "dev", self.iface])),
            ("application_ipv4", self.attachment["application_ipv4"], self.attachment["transport_gateway_ipv4"], self.iface, 4,
             ns_command(self.pid, [IP, "route", "del", f"{self.attachment['application_ipv4']}/32", "via", self.attachment["transport_gateway_ipv4"], "dev", self.iface])),
            ("gateway_ipv6", self.attachment["endpoint_ipv6"], self.attachment["transport_ipv6"], self.gateway_iface, 6,
             gateway_command(self.gateway_ns, ["-6", "route", "del", f"{self.attachment['endpoint_ipv6']}/128", "via", self.attachment["transport_ipv6"], "dev", self.gateway_iface])),
            ("gateway_ipv4", self.attachment["endpoint_ipv4"], self.attachment["transport_ipv4"], self.gateway_iface, 4,
             gateway_command(self.gateway_ns, ["route", "del", f"{self.attachment['endpoint_ipv4']}/32", "via", self.attachment["transport_ipv4"], "dev", self.gateway_iface])),
        )
        for name, target, gateway, interface, family, command in route_specs:
            try:
                if not self._remove_route(name, target, gateway, interface, family, command):
                    clean = False
            except (CommandError, PeerError):
                clean = False
        if self.veth_created or self.attachment["veth"] != "absent":
            try:
                host_links = run_json([IP, "-j", "link", "show"])
                gateway_links = link_list_gateway(self.gateway_ns)
                database_links = link_list_pid(self.pid)
                host_gateway = link_details(host_links, self.gateway_iface)
                host_interface = link_details(host_links, self.iface)
                gateway_link = link_details(gateway_links, self.gateway_iface)
                database_link = link_details(database_links, self.iface)
                self._link_matches(host_gateway, self.gateway_iface, host_links, self.host_gateway_identity, self.attachment["gateway_interface_mac"])
                self._link_matches(host_interface, self.iface, host_links, self.host_interface_identity, self.attachment["interface_mac"])
                self._link_matches(gateway_link, self.gateway_iface, gateway_links, self.host_gateway_identity, self.attachment["gateway_interface_mac"])
                self._link_matches(database_link, self.iface, database_links, self.host_interface_identity, self.attachment["interface_mac"])
                if gateway_link is not None:
                    run_command(gateway_command(self.gateway_ns, ["link", "del", self.gateway_iface]))
                elif database_link is not None:
                    run_command(ns_command(self.pid, [IP, "link", "del", self.iface]))
                elif host_gateway is not None:
                    run_command([IP, "link", "del", self.gateway_iface])
                elif host_interface is not None:
                    run_command([IP, "link", "del", self.iface])
                host_links = run_json([IP, "-j", "link", "show"])
                if link_details(host_links, self.gateway_iface) is not None or link_details(host_links, self.iface) is not None or link_details(link_list_gateway(self.gateway_ns), self.gateway_iface) is not None or link_details(link_list_pid(self.pid), self.iface) is not None:
                    clean = False
                elif self.attachment["veth"] != "absent":
                    self.attachment["veth"] = "absent"
                    self.registry.write_attachment(self.attachment)
            except (CommandError, PeerError):
                clean = False
        for family, state_name, address, prefix in ((4, "alias4", self.request["endpoint_ipv4"], 32), (6, "alias6", self.request["endpoint_ipv6"], 128)):
            if self.attachment[state_name] == "absent":
                continue
            try:
                present4, present6 = aliases_state(self.pid, self.request["endpoint_ipv4"], self.request["endpoint_ipv6"])
                present = present4 if family == 4 else present6
                if present:
                    args = [IP] if family == 4 else [IP, "-6"]
                    run_command(ns_command(self.pid, args + ["addr", "del", f"{address}/{prefix}", "dev", "lo"]))
                present4, present6 = aliases_state(self.pid, self.request["endpoint_ipv4"], self.request["endpoint_ipv6"])
                require(not (present4 if family == 4 else present6), "peer_alias_retained")
                self.attachment[state_name] = "absent"
                self.registry.write_attachment(self.attachment)
            except (CommandError, PeerError):
                clean = False
        if clean:
            try:
                current = self.registry.load_target(self.attachment["target_key"])
                if self.target_created:
                    if current is not None:
                        self.registry.remove_target(self.attachment["target_key"])
                elif self.original_target is not None:
                    require(current is not None, "peer_registry_target_invalid")
                    original_keys = {(item["allocation_id"], item["runtime_generation"], item["runtime_fence"]) for item in self.original_target["members"]}
                    current_keys = {(item["allocation_id"], item["runtime_generation"], item["runtime_fence"]) for item in current["members"] if (item["allocation_id"], item["runtime_generation"], item["runtime_fence"]) != (self.attachment["allocation_id"], self.attachment["runtime_generation"], self.attachment["runtime_fence"])}
                    require(current_keys == original_keys, "peer_registry_target_changed")
                    self.registry.write_target(self.original_target)
            except PeerError:
                clean = False
        if clean:
            try:
                self.registry.remove_attachment(self.attachment)
            except PeerError:
                clean = False
        return clean


def validate_attachment_request(attachment: dict[str, Any], request: dict[str, Any], target_key: str, db_inode: str, gateway_inode: str, app4: str, app6: str) -> None:
    expected = {
        "target_key": target_key,
        "allocation_id": request["allocation_id"],
        "runtime_generation": request["runtime_generation"],
        "runtime_fence": request["runtime_fence"],
        "run_id": request["run_id"],
        "container_id": request["container_id"],
        "tenant_database_id": request["tenant_database_id"],
        "database_generation": request["database_generation"],
        "restore_target": request["restore_target"],
        "endpoint_ipv4": request["endpoint_ipv4"],
        "endpoint_ipv6": request["endpoint_ipv6"],
        "gateway_ipv4": request["gateway_ipv4"],
        "gateway_ipv6": request["gateway_ipv6"],
    }
    require(all(attachment.get(name) == value for name, value in expected.items()), "peer_attachment_mismatch")
    require(attachment["application_ipv4"] == app4 and attachment["application_ipv6"] == app6, "peer_attachment_mismatch")
    require(str(attachment["database_namespace_inode"]) == str(db_inode) and str(attachment["gateway_namespace_inode"]) == str(gateway_inode), "peer_attachment_namespace_mismatch")


def commit_attachment(registry: Registry, attachment: dict[str, Any], target: dict[str, Any], request: dict[str, Any], target_key: str, peer_path: Path, pid: int, gateway_inode: str, member: dict[str, Any]) -> None:
    validate_member_shape(member)
    require(member["allocation_id"] == request["allocation_id"] and member["runtime_generation"] == request["runtime_generation"] and member["runtime_fence"] == request["runtime_fence"], "peer_attachment_mismatch")
    attachment["member"] = copy.deepcopy(member)
    attachment["state"] = "committing"
    registry.write_attachment(attachment)
    member_key = (member["allocation_id"], member["runtime_generation"], member["runtime_fence"])
    matches = [item for item in target["members"] if (item["allocation_id"], item["runtime_generation"], item["runtime_fence"]) == member_key]
    require(not matches or matches == [member], "peer_registry_member_mismatch")
    if not matches:
        target["members"].append(copy.deepcopy(member))
    target["detached_members"] = [item for item in target["detached_members"] if (item["allocation_id"], item["runtime_generation"], item["runtime_fence"]) != member_key]
    target["state"] = "active"
    registry.write_target(target)
    if peer_path.exists() or peer_path.is_symlink():
        require(is_regular(peer_path) and exact_realpath(peer_path), "peer_record_invalid")
        peer = read_json(peer_path)
        validate_peer_shape(peer, request, target_key, pid, gateway_inode)
        require(member_from_peer(peer) == member, "peer_registry_member_mismatch")
    else:
        atomic_write_json(peer_path, peer_value(request, target_key, pid, member))
    attachment["peer_written"] = True
    registry.write_attachment(attachment)
    registry.remove_attachment(attachment)


def recover_attachment(registry: Registry, attachment: dict[str, Any], request: dict[str, Any], generation_root: Path, ownership: dict[str, Any], pid: int, gateway_ns: str, gateway_inode: str, app4: str, app6: str) -> bool:
    target_key = attachment["target_key"]
    db_inode = str(os.stat(f"/proc/{pid}/ns/net").st_ino)
    validate_attachment_request(attachment, request, target_key, db_inode, gateway_inode, app4, app6)
    target = registry.load_target(target_key)
    if target is None and attachment["target_created"] and attachment["state"] == "rollback":
        registry.remove_attachment(attachment)
        return False
    require(target is not None, "peer_attachment_target_missing")
    validate_target_identity(target, request, target_key, db_inode)
    peer_path = generation_root / "postgres-peer.json"
    transaction = AttachTransaction(pid, gateway_ns, attachment["interface"], attachment["gateway_interface"], target, attachment["target_before"], attachment["target_created"], registry, generation_root, peer_path, request, attachment)
    if attachment["state"] in {"ready", "committing"}:
        try:
            member = attachment.get("member")
            if member is None:
                db_links = link_list_pid(pid)
                gateway_links = link_list_gateway(gateway_ns)
                member = make_member(request, db_inode, gateway_inode, attachment["interface"], attachment["gateway_interface"], link_details(db_links, attachment["interface"]), link_details(gateway_links, attachment["gateway_interface"]), (attachment["transport_ipv4"], attachment["transport_gateway_ipv4"], attachment["transport_ipv6"], attachment["transport_gateway_ipv6"]), app4, app6, db_links, gateway_links)
            require(member["interface_mac"] == attachment["interface_mac"] and member["gateway_interface_mac"] == attachment["gateway_interface_mac"], "peer_attachment_interface_mismatch")
            validate_member_current(pid, gateway_ns, member, request, gateway_inode)
            commit_attachment(registry, attachment, target, request, target_key, peer_path, pid, gateway_inode, member)
            return True
        except (PeerError, CommandError):
            pass
    if not transaction.rollback():
        fail("peer_partial_cleanup_pending")
    return False


def attach(registry: Registry, request: dict[str, Any], generation_root: Path, ownership: dict[str, Any], pid: int, gateway_ns: str, gateway_inode: str) -> None:
    allocation = request["allocation_id"]
    generation = request["runtime_generation"]
    iface = "p" + hash_text(f"{allocation}:{generation}")[:10]
    gateway_iface = "d" + hash_text(f"{allocation}:{generation}")[:10]
    peer_path = generation_root / "postgres-peer.json"
    app4, app6 = validate_outbound_and_app(ownership, request)
    db_inode = str(os.stat(f"/proc/{pid}/ns/net").st_ino)
    key = target_identity(request)
    original_target = registry.load_target(key)
    pending_key = attachment_key(key, request)
    pending = registry.load_attachment(pending_key)
    if pending is not None:
        if recover_attachment(registry, pending, request, generation_root, ownership, pid, gateway_ns, gateway_inode, app4, app6):
            print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "attach_postgres", "allocation_id": allocation, "container_id": request["container_id"]}, separators=(",", ":")))
            return
        original_target = registry.load_target(key)
    for other in registry.all_attachments():
        if other["target_key"] == key and attachment_key(key, other) != pending_key:
            fail("peer_target_attachment_pending")
    if peer_path.exists() or peer_path.is_symlink():
        require(original_target is not None, "peer_registry_target_missing")
        target = copy.deepcopy(original_target)
        validate_target_identity(target, request, key, db_inode)
        peer = read_json(peer_path)
        validate_peer_shape(peer, request, key, pid, gateway_inode)
        member = member_from_peer(peer)
        matches = [item for item in target["members"] if item["allocation_id"] == allocation and item["runtime_generation"] == generation and item["runtime_fence"] == request["runtime_fence"]]
        require(len(matches) == 1 and matches[0] == member, "peer_registry_member_mismatch")
        validate_member_current(pid, gateway_ns, member, request, gateway_inode)
        print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "attach_postgres", "allocation_id": allocation, "container_id": request["container_id"]}, separators=(",", ":")))
        return
    target_created = original_target is None
    if original_target is None:
        target = base_target(request, key, db_inode)
        registry.write_target(target)
    else:
        target = copy.deepcopy(original_target)
        validate_target_identity(target, request, key, db_inode)
        require(target["state"] in {"preparing", "active", "empty"}, "peer_registry_target_invalid")
        existing_member = next((member for member in target["members"] if member["allocation_id"] == allocation and member["runtime_generation"] == generation and member["runtime_fence"] == request["runtime_fence"]), None)
        if existing_member is not None:
            validate_member_current(pid, gateway_ns, existing_member, request, gateway_inode)
            atomic_write_json(peer_path, peer_value(request, key, pid, existing_member))
            print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "attach_postgres", "allocation_id": allocation, "container_id": request["container_id"]}, separators=(",", ":")))
            return
    host_links = run_json([IP, "-j", "link", "show"])
    require(isinstance(host_links, list), "peer_host_link_invalid")
    database_links = link_list_pid(pid)
    gateway_links = link_list_gateway(gateway_ns)
    require(link_details(host_links, iface) is None and link_details(host_links, gateway_iface) is None and link_details(database_links, iface) is None and link_details(gateway_links, gateway_iface) is None, "peer_interface_collision")
    transport = transport_candidate(registry, allocation, generation, request["runtime_fence"], pid)
    db_routes4 = route_entries_pid(pid, app4, 4)
    db_routes6 = route_entries_pid(pid, app6, 6)
    require(not db_routes4 and not db_routes6, "peer_application_route_collision")
    attachment = make_attachment(request, key, original_target, target_created, pid, db_inode, gateway_inode, app4, app6, transport, iface, gateway_iface)
    registry.write_attachment(attachment)
    if target["state"] == "empty":
        target["state"] = "preparing"
        registry.write_target(target)
    transaction = AttachTransaction(pid, gateway_ns, iface, gateway_iface, target, original_target, target_created, registry, generation_root, peer_path, request, attachment)
    try:
        present4, present6 = aliases_state(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])
        if target["loopback_aliases_present"]:
            require(present4 and present6, "peer_alias_missing")
        else:
            require(not present4 and not present6, "peer_endpoint_collision")
            transaction.journal(alias4="adding")
            try:
                run_command(ns_command(pid, [IP, "addr", "add", f"{request['endpoint_ipv4']}/32", "dev", "lo"]))
            except CommandError:
                fail("peer_alias_add_failed")
            require(aliases_state(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])[0], "peer_alias_missing")
            transaction.alias4 = True
            transaction.journal(alias4="owned")
            transaction.journal(alias6="adding")
            try:
                run_command(ns_command(pid, [IP, "-6", "addr", "add", f"{request['endpoint_ipv6']}/128", "dev", "lo", "nodad"]))
            except CommandError:
                fail("peer_alias_add_failed")
            require(aliases_state(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])[1], "peer_alias_missing")
            transaction.alias6 = True
            transaction.journal(alias6="owned")
            target["loopback_aliases_present"] = True
            if target["state"] == "preparing":
                registry.write_target(target)
        transaction.journal(veth="creating")
        try:
            run_command([IP, "link", "add", gateway_iface, "address", attachment["gateway_interface_mac"], "type", "veth", "peer", "name", iface, "address", attachment["interface_mac"]])
        except CommandError:
            fail("peer_veth_create_failed")
        transaction.veth_created = True
        host_links_after_add = run_json([IP, "-j", "link", "show"])
        transaction.host_gateway_identity = link_identity(link_details(host_links_after_add, gateway_iface), gateway_iface, host_links_after_add)
        transaction.host_interface_identity = link_identity(link_details(host_links_after_add, iface), iface, host_links_after_add)
        require(transaction.host_gateway_identity[1] == transaction.host_interface_identity[0] and transaction.host_interface_identity[1] == transaction.host_gateway_identity[0], "peer_interface_mismatch")
        require(transaction.host_gateway_identity[2] == attachment["gateway_interface_mac"] and transaction.host_interface_identity[2] == attachment["interface_mac"], "peer_interface_mismatch")
        transaction.journal(host_gateway_identity=list(transaction.host_gateway_identity), host_interface_identity=list(transaction.host_interface_identity), veth="host")
        try:
            run_command([IP, "link", "set", gateway_iface, "netns", gateway_ns])
            transaction.journal(veth="gateway_moved")
            run_command([IP, "link", "set", iface, "netns", str(pid)])
            transaction.journal(veth="database_moved")
        except CommandError:
            fail("peer_veth_move_failed")
        database_links = link_list_pid(pid)
        gateway_links = link_list_gateway(gateway_ns)
        db_link = link_details(database_links, iface)
        gateway_link = link_details(gateway_links, gateway_iface)
        transaction.member = make_member(request, db_inode, gateway_inode, iface, gateway_iface, db_link, gateway_link, transport, app4, app6, database_links, gateway_links)
        require(transaction.member["interface_mac"] == attachment["interface_mac"] and transaction.member["gateway_interface_mac"] == attachment["gateway_interface_mac"], "peer_interface_mismatch")
        transaction.journal(member=transaction.member, veth="ready")
        transport4, transport_gateway4, transport6, transport_gateway6 = transport
        for args in ([IP, "addr", "add", f"{transport4}/30", "dev", iface], [IP, "-6", "addr", "add", f"{transport6}/126", "dev", iface, "nodad"], [IP, "link", "set", iface, "up"]):
            try:
                run_command(ns_command(pid, args))
            except CommandError:
                fail("peer_veth_configure_failed")
        for args in (["addr", "add", f"{transport_gateway4}/30", "dev", gateway_iface], ["-6", "addr", "add", f"{transport_gateway6}/126", "dev", gateway_iface, "nodad"], ["link", "set", gateway_iface, "up"]):
            try:
                run_command(gateway_command(gateway_ns, args))
            except CommandError:
                fail("peer_veth_configure_failed")
        try:
            transaction.route_state("gateway_ipv4", "adding")
            run_command(gateway_command(gateway_ns, ["route", "add", f"{request['endpoint_ipv4']}/32", "via", transport4, "dev", gateway_iface]))
            transaction.route_state("gateway_ipv4", "owned")
            transaction.added_gateway4 = True
            transaction.route_state("gateway_ipv6", "adding")
            run_command(gateway_command(gateway_ns, ["-6", "route", "add", f"{request['endpoint_ipv6']}/128", "via", transport6, "dev", gateway_iface]))
            transaction.route_state("gateway_ipv6", "owned")
            transaction.added_gateway6 = True
            transaction.route_state("application_ipv4", "adding")
            run_command(ns_command(pid, [IP, "route", "add", f"{app4}/32", "via", transport_gateway4, "dev", iface]))
            transaction.route_state("application_ipv4", "owned")
            transaction.added_app4 = True
            transaction.route_state("application_ipv6", "adding")
            run_command(ns_command(pid, [IP, "-6", "route", "add", f"{app6}/128", "via", transport_gateway6, "dev", iface]))
            transaction.route_state("application_ipv6", "owned")
            transaction.added_app6 = True
        except CommandError:
            fail("peer_route_add_failed")
        require(route_matches(route_entries_gateway(gateway_ns, request["endpoint_ipv4"], 4), request["endpoint_ipv4"], transport4, gateway_iface, 4), "peer_route_missing")
        require(route_matches(route_entries_gateway(gateway_ns, request["endpoint_ipv6"], 6), request["endpoint_ipv6"], transport6, gateway_iface, 6), "peer_route_missing")
        require(route_matches(route_entries_pid(pid, app4, 4), app4, transport_gateway4, iface, 4), "peer_route_missing")
        require(route_matches(route_entries_pid(pid, app6, 6), app6, transport_gateway6, iface, 6), "peer_route_missing")
        transaction.journal(state="ready")
        commit_attachment(registry, attachment, target, request, key, peer_path, pid, gateway_inode, transaction.member)
        transaction.peer_written = True
    except (PeerError, CommandError):
        clean = transaction.rollback()
        if not clean:
            print("peer_partial_cleanup_pending", file=sys.stderr)
        raise
    print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "attach_postgres", "allocation_id": allocation, "container_id": request["container_id"]}, separators=(",", ":")))


def member_network_absent(pid: int, gateway_ns: str, member: dict[str, Any], request: dict[str, Any]) -> bool:
    db_links = link_list_pid(pid)
    gateway_links = link_list_gateway(gateway_ns)
    db_link = link_details(db_links, member["interface"])
    gateway_link = link_details(gateway_links, member["gateway_interface"])
    if db_link is not None or gateway_link is not None:
        require(db_link is not None and gateway_link is not None, "peer_interface_mismatch")
        db_index, db_peer_index, db_mac = link_identity(db_link, member["interface"], db_links)
        gateway_index, gateway_peer_index, gateway_mac = link_identity(gateway_link, member["gateway_interface"], gateway_links)
        require(db_index == member["interface_ifindex"] and db_peer_index == member["interface_peer_ifindex"] and db_mac == member["interface_mac"] and gateway_index == member["gateway_interface_ifindex"] and gateway_peer_index == member["gateway_interface_peer_ifindex"] and gateway_mac == member["gateway_interface_mac"], "peer_interface_mismatch")
        return False
    require(not route_entries_pid(pid, member["application_ipv4"], 4) and not route_entries_pid(pid, member["application_ipv6"], 6), "peer_route_retained")
    require(not route_entries_gateway(gateway_ns, request["endpoint_ipv4"], 4) and not route_entries_gateway(gateway_ns, request["endpoint_ipv6"], 6), "peer_route_retained")
    return True


def reconcile_detached_absence(target: dict[str, Any], request: dict[str, Any], ownership: dict[str, Any], pid: int, gateway_ns: str, gateway_inode: str, member: dict[str, Any]) -> None:
    detached = target.get("detached_members")
    require(isinstance(detached, list) and any(item == member for item in detached), "peer_record_missing")
    app4, app6 = validate_outbound_and_app(ownership, request)
    require(member["application_ipv4"] == app4 and member["application_ipv6"] == app6 and member["container_id"] == request["container_id"] and str(member["gateway_namespace_inode"]) == gateway_inode and str(member["database_namespace_inode"]) == str(os.stat(f"/proc/{pid}/ns/net").st_ino), "peer_record_mismatch")
    iface = "p" + hash_text(f"{request['allocation_id']}:{request['runtime_generation']}")[:10]
    gateway_iface = "d" + hash_text(f"{request['allocation_id']}:{request['runtime_generation']}")[:10]
    require(member["interface"] == iface and member["gateway_interface"] == gateway_iface, "peer_record_mismatch")
    require(link_details(link_list_pid(pid), iface) is None and link_details(link_list_gateway(gateway_ns), gateway_iface) is None, "peer_interface_retained")
    require(not route_entries_pid(pid, app4, 4) and not route_entries_pid(pid, app6, 6), "peer_route_retained")
    require(not route_entries_gateway(gateway_ns, request["endpoint_ipv4"], 4) and not route_entries_gateway(gateway_ns, request["endpoint_ipv6"], 6), "peer_route_retained")
    present4, present6 = aliases_state(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])
    if target["members"]:
        require(present4 and present6, "peer_alias_missing")
    else:
        require(not present4 and not present6, "peer_alias_retained")


def detach(registry: Registry, request: dict[str, Any], generation_root: Path, ownership: dict[str, Any], pid: int, gateway_ns: str, gateway_inode: str) -> None:
    peer_path = generation_root / "postgres-peer.json"
    key = target_identity(request)
    for pending in registry.all_attachments():
        if pending["target_key"] == key:
            fail("peer_target_attachment_pending")
    target = registry.load_target(key)
    require(target is not None, "peer_registry_target_missing")
    db_inode = str(os.stat(f"/proc/{pid}/ns/net").st_ino)
    validate_target_identity(target, request, key, db_inode)
    peer_present = peer_path.exists() or peer_path.is_symlink()
    peer = None
    if peer_present:
        require(is_regular(peer_path) and exact_realpath(peer_path), "peer_record_missing")
        peer = read_json(peer_path)
        validate_peer_shape(peer, request, key, pid, gateway_inode)
    member_from_request = member_from_peer(peer) if peer is not None else None
    matches = [item for item in target["members"] if item["allocation_id"] == request["allocation_id"] and item["runtime_generation"] == request["runtime_generation"] and item["runtime_fence"] == request["runtime_fence"]]
    if not matches:
        if member_from_request is None:
            detached = target.get("detached_members", [])
            member_from_request = next((item for item in detached if isinstance(item, dict) and item["allocation_id"] == request["allocation_id"] and item["runtime_generation"] == request["runtime_generation"] and item["runtime_fence"] == request["runtime_fence"]), None)
        require(member_from_request is not None, "peer_record_missing")
        require(member_from_request["allocation_id"] == request["allocation_id"] and member_from_request["runtime_generation"] == request["runtime_generation"] and member_from_request["runtime_fence"] == request["runtime_fence"], "peer_record_missing")
        reconcile_detached_absence(target, request, ownership, pid, gateway_ns, gateway_inode, member_from_request)
        if peer_present:
            try:
                peer_path.unlink()
            except OSError:
                fail("peer_record_remove_failed")
        print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "detach_postgres", "allocation_id": request["allocation_id"], "container_id": request["container_id"]}, separators=(",", ":")))
        return
    require(len(matches) == 1, "peer_registry_member_mismatch")
    member = matches[0]
    if member_from_request is not None:
        require(member == member_from_request, "peer_registry_member_mismatch")
    validate_member_binding(pid, gateway_ns, member, request, gateway_inode)
    require(len(target["detached_members"]) < 256, "peer_registry_completion_limit")
    if not member_network_absent(pid, gateway_ns, member, request):
        for family, address, database_gateway, gateway_target, iface in ((4, member["application_ipv4"], member["transport_gateway_ipv4"], member["transport_ipv4"], member["interface"]), (6, member["application_ipv6"], member["transport_gateway_ipv6"], member["transport_ipv6"], member["interface"])):
            entries = route_entries_pid(pid, address, family)
            if entries:
                require(route_matches(entries, address, database_gateway, iface, family), "peer_route_mismatch")
                args = [IP]
                if family == 6:
                    args.append("-6")
                args += ["route", "del", f"{address}/{32 if family == 4 else 128}", "via", database_gateway, "dev", iface]
                try:
                    run_command(ns_command(pid, args))
                except CommandError:
                    fail("peer_route_remove_failed")
            target_address = request["endpoint_ipv4" if family == 4 else "endpoint_ipv6"]
            entries = route_entries_gateway(gateway_ns, target_address, family)
            if entries:
                require(route_matches(entries, target_address, gateway_target, member["gateway_interface"], family), "peer_route_mismatch")
                args = []
                if family == 6:
                    args.append("-6")
                args += ["route", "del", f"{target_address}/{32 if family == 4 else 128}", "via", gateway_target, "dev", member["gateway_interface"]]
                try:
                    run_command(gateway_command(gateway_ns, args))
                except CommandError:
                    fail("peer_route_remove_failed")
        try:
            run_command(gateway_command(gateway_ns, ["link", "del", member["gateway_interface"]]))
        except CommandError:
            db_link = link_details(link_list_pid(pid), member["interface"])
            require(db_link is not None, "peer_veth_remove_failed")
            try:
                run_command(ns_command(pid, [IP, "link", "del", member["interface"]]))
            except CommandError:
                fail("peer_veth_remove_failed")
        require(member_network_absent(pid, gateway_ns, member, request), "peer_veth_retained")
    remaining = [item for item in target["members"] if not (item["allocation_id"] == member["allocation_id"] and item["runtime_generation"] == member["runtime_generation"] and item["runtime_fence"] == member["runtime_fence"])]
    if remaining:
        target["members"] = remaining
        target["state"] = "active"
        target["detached_members"].append(member)
        registry.write_target(target)
        if peer_present:
            try:
                peer_path.unlink()
            except OSError:
                fail("peer_record_remove_failed")
    else:
        remove_aliases(pid, request["endpoint_ipv4"], request["endpoint_ipv6"])
        target["members"] = []
        target["state"] = "empty"
        target["loopback_aliases_present"] = False
        target["detached_members"].append(member)
        registry.write_target(target)
        if peer_present:
            try:
                peer_path.unlink()
            except OSError:
                fail("peer_record_remove_failed")
    print(json.dumps({"schema": RECEIPT_SCHEMA, "result": "passed", "operation": "detach_postgres", "allocation_id": request["allocation_id"], "container_id": request["container_id"]}, separators=(",", ":")))


def main(argv: list[str]) -> int:
    if len(argv) != 6 or argv[0] != "--request-file" or argv[2] != "--request-sha256" or argv[4] != "--state-root":
        print("peer_usage", file=sys.stderr)
        return 2
    request_source = Path(argv[1])
    digest = argv[3]
    state_root = Path(argv[5])
    request_copy: Path | None = None
    try:
        request, request_copy = parse_request(request_source, digest, state_root)
        validate_request(request)
        pid, _ = inspect_container(request["container_id"], request)
        gateway_ns = f"hostlet-gateway-{request['allocation_id']}-{request['runtime_generation']}"
        generation_root, ownership, gateway_inode = validate_ownership(state_root, request, gateway_ns)
        with locked_registry(state_root) as registry:
            if request["operation"] == "attach_postgres":
                attach(registry, request, generation_root, ownership, pid, gateway_ns, gateway_inode)
            else:
                detach(registry, request, generation_root, ownership, pid, gateway_ns, gateway_inode)
        return 0
    except PeerError as error:
        print(error.message, file=sys.stderr)
        return error.status
    except (CommandError, OSError, ValueError, TypeError):
        print("peer_internal_failure", file=sys.stderr)
        return 1
    finally:
        if request_copy is not None:
            try:
                request_copy.unlink()
            except OSError:
                pass


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
