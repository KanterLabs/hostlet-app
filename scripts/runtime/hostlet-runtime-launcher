unmount_recorded_mount() {
  local target=$1 expected_identity=$2 source_kind=$3 source=$4 source_inode=$5 target_inode=$6 record
  [[ -n "$target" && -n "$expected_identity" ]] || return 1
  [[ ! -e "$target" ]] && return 0
  [[ -d "$target" && ! -L "$target" ]] || return 1
  if mountpoint -q "$target"; then
    record=$(mount_identity "$target") || return 1
    [[ "$record" == "$expected_identity" ]] || return 1
    if [[ "$source_kind" == rootfs ]]; then
      validate_rootfs_mount "$expected_identity" "$source" "$source_inode" "$target_inode" || return 1
    elif [[ "$source_kind" == rootfs_partial ]]; then
      validate_rootfs_mount_basic "$expected_identity" "$source" "$source_inode" "$target_inode" || return 1
    else
      validate_secret_mount "$expected_identity" "$target_inode" || return 1
    fi
    umount -- "$target" || return 1
  else
    [[ -z "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]] || return 1
  fi
  [[ ! -e "$target" ]] || rmdir -- "$target"
}

remove_mount_tuple() {
  [[ ! -e "$mount_tuple" ]] && return 0
  validate_mount_tuple || return 1
  [[ ! -e "$rootfs_mount" && ! -e "$secret_mount" ]] || return 1
