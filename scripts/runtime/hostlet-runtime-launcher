  trap 'rm -f -- "$request_copy"' EXIT
}

if [[ "$op" != prepare && "$op" != cleanup ]]; then
  [[ -f "$generation_root/OWNERSHIP.json" && ! -L "$generation_root/OWNERSHIP.json" ]] || { echo runtime_ownership_missing >&2; exit 1; }
  jq -e --arg id "$id" --argjson generation "$generation" --argjson fence "$fence" --arg identity_sha "$request_identity_sha256" --arg cgroup_identity "$cgroup_identity_hash" '.allocation_id==$id and .generation==$generation and .fence==$fence and .request_identity_sha256==$identity_sha and .cgroup_identity_hash==$cgroup_identity' "$generation_root/OWNERSHIP.json" >/dev/null || { echo runtime_ownership_mismatch >&2; exit 1; }
  load_cgroup_state || { echo runtime_cgroup_state_invalid >&2; exit 1; }
fi

case "$op" in
  prepare) prepare;;
  start)
    [[ -f "$bundle/config.json" ]] || { echo runtime_not_prepared >&2; exit 1; }
    validate_cgroup_config_path || { emit stopped runtime_isolation_unverified false failed; exit 1; }
    if ! create_budget_cgroup; then
      emit stopped runtime_isolation_unverified false failed
      exit 1
    fi
    if ! runsc_quiet create --bundle "$bundle" "$sandbox"; then
      remove_budget_cgroup || true
      emit stopped runtime_internal_failure false failed
      exit 1
    fi
    if ! configure_cgroup; then
      runsc_quiet delete --force "$sandbox" || true
      if ! remove_budget_cgroup; then
        emit cleanup_pending runtime_cleanup_incomplete false failed
      else
        emit stopped runtime_isolation_unverified false failed
      fi
      exit 1
    fi
    if ! restore_application_network; then
      runsc_quiet delete --force "$sandbox" || true
      if ! remove_budget_cgroup; then
        emit cleanup_pending runtime_cleanup_incomplete false failed
      else
        emit stopped runtime_isolation_unverified false failed
      fi
      exit 1
    fi
    if ! runsc_quiet start "$sandbox"; then
      runsc_quiet delete --force "$sandbox" || true
      if ! remove_budget_cgroup; then
        emit cleanup_pending runtime_cleanup_incomplete false failed
      else
        emit stopped runtime_internal_failure false failed
      fi
      exit 1
    fi
    emit running runtime_started;;
  inspect) state=$("$runsc" "${global[@]}" state "$sandbox" 2>/dev/null | jq -r .status || true); if [[ "$state" == running ]]; then emit running runtime_started true; else emit stopped runtime_exit false failed; fi;;
  reconcile)
    now=$(date +%s); restart_file="$generation_root/restart-state.json"; [[ -f "$restart_file" ]] || echo '{"exits":[],"healthy_since":null}' > "$restart_file"
    state=$("$runsc" "${global[@]}" state "$sandbox" 2>/dev/null | jq -r .status || true)
    if [[ "$state" == running ]]; then
      health=$(health_observation true); if [[ "$(jq -r .passing <<<"$health")" == true ]]; then since=$(jq -r '.healthy_since // empty' "$restart_file"); [[ -n "$since" ]] || since=$now; if (( now - since >= 600 )); then jq --argjson now "$now" '.exits=[]|.healthy_since=$now' "$restart_file" > "$restart_file.new"; else jq --argjson since "$since" '.healthy_since=$since' "$restart_file" > "$restart_file.new"; fi; mv "$restart_file.new" "$restart_file"; emit running runtime_started true; else emit running health_failed true failed; fi
    else
